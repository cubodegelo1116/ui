		-- State
		local currentOptions = {}
		for _, opt in ipairs(options) do
			if typeof(opt) == "string" then
				table.insert(currentOptions, opt)
			end
		end

		local currentValue = currentOptions[1]
		local open = false

		-- Dropdown list
		local List = Instance.new("ScrollingFrame")
		List.Name = "DropdownList"
		List.BackgroundColor3 = Theme.TitleBar
		List.BorderSizePixel = 0
		List.Visible = false
		List.ZIndex = 50
