	-- ════════════════════════════════════════════════════════════
	-- THEME MANAGEMENT SYSTEM
	-- ════════════════════════════════════════════════════════════

	local function RegisterTheme(name, colors)
		if typeof(name) ~= "string" then
			warn("UI: RegisterTheme - name must be a string")
			return nil
		end

		if typeof(colors) ~= "table" then
			warn("UI: RegisterTheme - colors must be a table")
			return nil
		end

		local newTheme = CopyTable(Themes.Default)

		for key, value in pairs(colors) do
			if newTheme[key] ~= nil then
				if typeof(value) ~= "Color3" then
					warn("UI: RegisterTheme - color '" .. tostring(key) .. "' must be Color3")
					return nil
				end
				newTheme[key] = value
			else
				warn("UI: RegisterTheme - unknown color key: " .. tostring(key))
			end
		end

		Themes[name] = newTheme
		return newTheme
	end

	local ApplyTheme

	local function SetTheme(themeName)
		if typeof(themeName) == "string" then
			if not Themes[themeName] then
				warn("UI: SetTheme - theme '" .. themeName .. "' does not exist")
				return false
			end

			local selectedTheme = Themes[themeName]
			for key, value in pairs(selectedTheme) do
				if Theme[key] ~= nil then
					Theme[key] = value
				end
			end
		elseif typeof(themeName) == "table" then
			for key, value in pairs(themeName) do
				if Theme[key] ~= nil and typeof(value) ~= "Color3" then
					warn("UI: SetTheme - color '" .. tostring(key) .. "' must be Color3")
					return false
				end
			end
			for key, value in pairs(themeName) do
				if Theme[key] ~= nil then
					Theme[key] = value
				end
			end
		else
			warn("UI: SetTheme - invalid theme type")
			return false
		end

		ApplyTheme()
		return true
	end

	local function GetTheme(themeName)
		if themeName then
			local selected = Themes[themeName]
			return selected and CopyTable(selected) or nil
		end
		return CopyTable(Theme)
	end

	local function GetAllThemes()
		local result = {}
		for name in pairs(Themes) do
			table.insert(result, name)
		end
		table.sort(result)
		return result
	end

