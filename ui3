-- 1. BOTÃO NORMAL
function CreateButton(parent, label, callback)
    local Button = Instance.new("TextButton")
    Button.Size = UDim2.new(1, -20, 0, 35)
    Button.BackgroundColor3 = Color3.fromRGB(50, 50, 60)
    Button.BorderSizePixel = 0
    Button.Text = label
    Button.TextColor3 = Color3.fromRGB(255, 255, 255)
    Button.TextSize = 14
    Button.Font = Enum.Font.GothamSemibold
    Button.Parent = parent
    
    local ButtonCorner = Instance.new("UICorner")
    ButtonCorner.CornerRadius = UDim.new(0, 5)
    ButtonCorner.Parent = Button
    
    Button.MouseEnter:Connect(function()
        TweenService:Create(Button, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(65, 65, 75)}):Play()
    end)
    Button.MouseLeave:Connect(function()
        TweenService:Create(Button, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(50, 50, 60)}):Play()
    end)
    
    Button.MouseButton1Click:Connect(function()
        if callback then callback() end
    end)
    
    return Button
end

-- 2. DROPDOWN
function CreateDropdown(parent, label, options, default, callback)
    local DropdownFrame = Instance.new("Frame")
    DropdownFrame.Size = UDim2.new(1, -20, 0, 35)
    DropdownFrame.BackgroundColor3 = Color3.fromRGB(40, 40, 45)
    DropdownFrame.BorderSizePixel = 0
    DropdownFrame.ClipsDescendants = true
    DropdownFrame.Parent = parent
    
    local DropCorner = Instance.new("UICorner")
    DropCorner.CornerRadius = UDim.new(0, 5)
    DropCorner.Parent = DropdownFrame
    
    local LabelText = Instance.new("TextLabel")
    LabelText.Size = UDim2.new(0.5, 0, 1, 0)
    LabelText.BackgroundTransparency = 1
    LabelText.Text = label
    LabelText.TextColor3 = Color3.fromRGB(200, 200, 210)
    LabelText.TextSize = 13
    LabelText.Font = Enum.Font.Gotham
    LabelText.TextXAlignment = Enum.TextXAlignment.Left
    LabelText.Position = UDim2.new(0, 10, 0, 0)
    LabelText.Parent = DropdownFrame
    
    local DropButton = Instance.new("TextButton")
    DropButton.Size = UDim2.new(0.5, -15, 1, 0)
    DropButton.Position = UDim2.new(0.5, 5, 0, 0)
    DropButton.BackgroundColor3 = Color3.fromRGB(55, 55, 65)
    DropButton.BorderSizePixel = 0
    DropButton.Text = default or options[1] or "Selecione"
    DropButton.TextColor3 = Color3.fromRGB(255, 255, 255)
    DropButton.TextSize = 13
    DropButton.Font = Enum.Font.Gotham
    DropButton.Parent = DropdownFrame
    
    local DropButtonCorner = Instance.new("UICorner")
    DropButtonCorner.CornerRadius = UDim.new(0, 4)
    DropButtonCorner.Parent = DropButton
    
    local expanded = false
    local optionButtons = {}
    
    DropButton.MouseButton1Click:Connect(function()
        expanded = not expanded
        DropdownFrame.Size = expanded and UDim2.new(1, -20, 0, 35 + (#options * 30)) or UDim2.new(1, -20, 0, 35)
        
        if expanded then
            for i, opt in ipairs(options) do
                local optBtn = Instance.new("TextButton")
                optBtn.Size = UDim2.new(0.5, -15, 0, 25)
                optBtn.Position = UDim2.new(0.5, 5, 0, 35 + ((i-1) * 28))
                optBtn.BackgroundColor3 = Color3.fromRGB(45, 45, 55)
                optBtn.BorderSizePixel = 0
                optBtn.Text = opt
                optBtn.TextColor3 = Color3.fromRGB(200, 200, 210)
                optBtn.TextSize = 13
                optBtn.Font = Enum.Font.Gotham
                optBtn.Parent = DropdownFrame
                
                local optCorner = Instance.new("UICorner")
                optCorner.CornerRadius = UDim.new(0, 4)
                optCorner.Parent = optBtn
                
                optBtn.MouseEnter:Connect(function()
                    TweenService:Create(optBtn, TweenInfo.new(0.1), {BackgroundColor3 = Color3.fromRGB(60, 60, 75)}):Play()
                end)
                optBtn.MouseLeave:Connect(function()
                    TweenService:Create(optBtn, TweenInfo.new(0.1), {BackgroundColor3 = Color3.fromRGB(45, 45, 55)}):Play()
                end)
                
                optBtn.MouseButton1Click:Connect(function()
                    DropButton.Text = opt
                    expanded = false
                    DropdownFrame.Size = UDim2.new(1, -20, 0, 35)
                    for _, btn in pairs(DropdownFrame:GetChildren()) do
                        if btn:IsA("TextButton") and btn ~= DropButton then
                            btn:Destroy()
                        end
                    end
                    if callback then callback(opt) end
                end)
                
                table.insert(optionButtons, optBtn)
            end
        else
            for _, btn in pairs(DropdownFrame:GetChildren()) do
                if btn:IsA("TextButton") and btn ~= DropButton then
                    btn:Destroy()
                end
            end
        end
    end)
    
    return DropdownFrame
end

-- 3. SLIDER (SLIDE)
function CreateSlider(parent, label, min, max, default, callback)
    local SliderFrame = Instance.new("Frame")
    SliderFrame.Size = UDim2.new(1, -20, 0, 50)
    SliderFrame.BackgroundTransparency = 1
    SliderFrame.Parent = parent
    
    local LabelText = Instance.new("TextLabel")
    LabelText.Size = UDim2.new(1, 0, 0, 20)
    LabelText.BackgroundTransparency = 1
    LabelText.Text = label .. ": " .. tostring(default or min)
    LabelText.TextColor3 = Color3.fromRGB(200, 200, 210)
    LabelText.TextSize = 13
    LabelText.Font = Enum.Font.Gotham
    LabelText.TextXAlignment = Enum.TextXAlignment.Left
    LabelText.Parent = SliderFrame
    
    local SliderBar = Instance.new("Frame")
    SliderBar.Size = UDim2.new(1, 0, 0, 6)
    SliderBar.Position = UDim2.new(0, 0, 0, 28)
    SliderBar.BackgroundColor3 = Color3.fromRGB(50, 50, 60)
    SliderBar.BorderSizePixel = 0
    SliderBar.Parent = SliderFrame
    
    local SliderBarCorner = Instance.new("UICorner")
    SliderBarCorner.CornerRadius = UDim.new(1, 0)
    SliderBarCorner.Parent = SliderBar
    
    local Fill = Instance.new("Frame")
    Fill.Size = UDim2.new((default or min - min) / (max - min), 0, 1, 0)
    Fill.BackgroundColor3 = Color3.fromRGB(80, 150, 255)
    Fill.BorderSizePixel = 0
    Fill.Parent = SliderBar
    
    local FillCorner = Instance.new("UICorner")
    FillCorner.CornerRadius = UDim.new(1, 0)
    FillCorner.Parent = Fill
    
    local SliderButton = Instance.new("TextButton")
    SliderButton.Size = UDim2.new(0, 16, 0, 16)
    SliderButton.Position = UDim2.new((default or min - min) / (max - min), -8, 0.5, -8)
    SliderButton.BackgroundColor3 = Color3.fromRGB(100, 170, 255)
    SliderButton.BorderSizePixel = 0
    SliderButton.Text = ""
    SliderButton.Parent = SliderBar
    
    local SliderButtonCorner = Instance.new("UICorner")
    SliderButtonCorner.CornerRadius = UDim.new(1, 0)
    SliderButtonCorner.Parent = SliderButton
    
    local dragging = false
    local value = default or min
    
    local function UpdateSlider(input)
        local relativeX = math.clamp((input.Position.X - SliderBar.AbsolutePosition.X) / SliderBar.AbsoluteSize.X, 0, 1)
        Fill.Size = UDim2.new(relativeX, 0, 1, 0)
        SliderButton.Position = UDim2.new(relativeX, -8, 0.5, -8)
        value = math.floor(min + (max - min) * relativeX)
        LabelText.Text = label .. ": " .. tostring(value)
        if callback then callback(value) end
    end
    
    SliderButton.MouseButton1Down:Connect(function()
        dragging = true
    end)
    
    UserInputService.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            UpdateSlider(input)
        end
    end)
    
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)
    
    -- Clique na barra
    SliderBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            UpdateSlider(input)
        end
    end)
    
    return SliderFrame
end

-- 4. COOLDOWN BUTTON
function CreateCooldownButton(parent, label, cooldown, callback)
    local Button = Instance.new("TextButton")
    Button.Size = UDim2.new(1, -20, 0, 35)
    Button.BackgroundColor3 = Color3.fromRGB(200, 80, 60)
    Button.BorderSizePixel = 0
    Button.Text = label
    Button.TextColor3 = Color3.fromRGB(255, 255, 255)
    Button.TextSize = 14
    Button.Font = Enum.Font.GothamSemibold
    Button.Parent = parent
    
    local ButtonCorner = Instance.new("UICorner")
    ButtonCorner.CornerRadius = UDim.new(0, 5)
    ButtonCorner.Parent = Button
    
    local onCooldown = false
    
    Button.MouseButton1Click:Connect(function()
        if onCooldown then return end
        if callback then callback() end
        
        onCooldown = true
        Button.BackgroundColor3 = Color3.fromRGB(100, 100, 110)
        Button.Text = label .. " (" .. cooldown .. "s)"
        
        local remaining = cooldown
        local timer = RunService.Heartbeat:Connect(function()
            remaining = remaining - 0.1
            if remaining <= 0 then
                timer:Disconnect()
                onCooldown = false
                Button.BackgroundColor3 = Color3.fromRGB(200, 80, 60)
                Button.Text = label
            else
                Button.Text = label .. " (" .. math.ceil(remaining) .. "s)"
            end
        end)
    end)
    
    return Button
end

