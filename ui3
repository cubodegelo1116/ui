	-- ─────────────────────────────────────────────────────────

	function AddToggle(page, text, default, callback)
		if not page then error("Page required for AddToggle", 2) end
		text = ValidateString(text, true) or "Toggle"
		default = default or false

		local Frame = Instance.new("Frame")
		Frame.Name = text
		Frame.Size = UDim2.new(1, 0, 0, 32)
		Frame.BackgroundTransparency = 1
		Frame.Parent = page

		local Label = Instance.new("TextLabel")
		Label.Size = UDim2.new(1, -55, 1, 0)
		Label.BackgroundTransparency = 1
		Label.Text = text
		Label.TextColor3 = Theme.Text
		Label.TextSize = 13
		Label.Font = Enum.Font.Gotham
		Label.TextXAlignment = Enum.TextXAlignment.Left
		Label.TextYAlignment = Enum.TextYAlignment.Center
		Label.Parent = Frame
		Label:SetAttribute("ThemeRole", "Text")
		Label.TextStrokeTransparency = 1

		local state = default == true

		local Toggle = Instance.new("TextButton")
		Toggle.Size = UDim2.new(0, 44, 0, 22)
		Toggle.Position = UDim2.new(1, -44, 0.5, -11)
		Toggle.BackgroundColor3 = state and Theme.ToggleOn or Theme.ToggleOff
		Toggle.BorderSizePixel = 0
		Toggle.Text = ""
		Toggle.AutoButtonColor = false
		Toggle.Parent = Frame
		Toggle:SetAttribute("ThemeRole", state and "ToggleOn" or "ToggleOff")

		local ToggleCorner = Instance.new("UICorner")
		ToggleCorner.CornerRadius = UDim.new(1, 0)
		ToggleCorner.Parent = Toggle

		local Circle = Instance.new("Frame")
		Circle.Size = UDim2.new(0, 16, 0, 16)
		Circle.Position = state and UDim2.new(1, -19, 0.5, -8) or UDim2.new(0, 3, 0.5, -8)
		Circle.BackgroundColor3 = Color3.fromRGB(240, 240, 240)
		Circle.BorderSizePixel = 0
		Circle.Parent = Toggle

		local CircleCorner = Instance.new("UICorner")
		CircleCorner.CornerRadius = UDim.new(1, 0)
		CircleCorner.Parent = Circle

		local function SetState(newState)
			if typeof(newState) ~= "boolean" or newState == state then
				return
			end

			state = newState
			local goalPos = state and UDim2.new(1, -19, 0.5, -8) or UDim2.new(0, 3, 0.5, -8)
			local goalColor = state and Theme.ToggleOn or Theme.ToggleOff
			Toggle:SetAttribute("ThemeRole", state and "ToggleOn" or "ToggleOff")
			TweenService:Create(Circle, TweenInfo.new(ANIMATION_SPEED), {Position = goalPos}):Play()
			TweenService:Create(Toggle, TweenInfo.new(ANIMATION_SPEED), {BackgroundColor3 = goalColor}):Play()

			if typeof(callback) == "function" then
				callback(state)
			end
		end

		Toggle.MouseButton1Click:Connect(function()
			SetState(not state)
		end)

		-- Return API
		local ToggleAPI = {}
		function ToggleAPI.SetState(newState)
			SetState(newState)
		end
		function ToggleAPI.GetState()
			return state
		end

		return ToggleAPI
	end

	-- ─────────────────────────────────────────────────────────
	-- SLIDER COMPONENT
	-- ─────────────────────────────────────────────────────────

	function AddSlider(page, text, min, max, default, callback)
		if not page then error("Page required for AddSlider", 2) end
		text = ValidateString(text, true) or "Slider"
		min = tonumber(min) or 0
		max = tonumber(max) or 100
		default = tonumber(default) or min

		-- Validate ranges
		if min > max then min, max = max, min end
		default = Clamp(math.floor(default + 0.5), min, max)

		local Frame = Instance.new("Frame")
		Frame.Name = text
		Frame.Size = UDim2.new(1, 0, 0, 46)
		Frame.BackgroundTransparency = 1
		Frame.Parent = page

		local Label = Instance.new("TextLabel")
		Label.Size = UDim2.new(1, 0, 0, 18)
		Label.BackgroundTransparency = 1
		Label.Text = text .. ": " .. tostring(default)
		Label.TextColor3 = Theme.Text
		Label.TextSize = 13
		Label.Font = Enum.Font.Gotham
		Label.TextXAlignment = Enum.TextXAlignment.Left
		Label.TextYAlignment = Enum.TextYAlignment.Center
		Label.Parent = Frame
		Label:SetAttribute("ThemeRole", "Text")
		Label.TextStrokeTransparency = 1

		local Bar = Instance.new("Frame")
		Bar.Size = UDim2.new(1, 0, 0, 8)
		Bar.Position = UDim2.new(0, 0, 0, 28)
		Bar.BackgroundColor3 = Theme.ToggleOff
		Bar.BorderSizePixel = 0
		Bar.Parent = Frame
		Bar:SetAttribute("ThemeRole", "ToggleOff")

		local BarCorner = Instance.new("UICorner")
		BarCorner.CornerRadius = UDim.new(0, 2)
		BarCorner.Parent = Bar

		-- Calculate initial percent (safe from division by zero)
		local function GetPercent(value)
			if max == min then return 0 end
			return Clamp((value - min) / (max - min), 0, 1)
		end

		local percent = GetPercent(default)
		local currentValue = default

		local Fill = Instance.new("Frame")
		Fill.Size = UDim2.new(percent, 0, 1, 0)
		Fill.BackgroundColor3 = Theme.Accent
		Fill.BorderSizePixel = 0
		Fill.Parent = Bar
		Fill:SetAttribute("ThemeRole", "Accent")

		local FillCorner = Instance.new("UICorner")
		FillCorner.CornerRadius = UDim.new(0, 2)
		FillCorner.Parent = Fill

		local Handle = Instance.new("Frame")
		Handle.Size = UDim2.new(0, 16, 0, 16)
		Handle.Position = UDim2.new(percent, -8, 0.5, -8)
		Handle.BackgroundColor3 = Color3.fromRGB(240, 240, 240)
		Handle.BorderSizePixel = 0
		Handle.ZIndex = 2
		Handle.Parent = Bar

		local HandleCorner = Instance.new("UICorner")
		HandleCorner.CornerRadius = UDim.new(0, 4)
		HandleCorner.Parent = Handle

		local draggingSlider = false

		local function UpdateSlider(input)
			if Bar.AbsoluteSize.X <= 0 then return end

			local newPercent = Clamp(
				(input.Position.X - Bar.AbsolutePosition.X) / Bar.AbsoluteSize.X,
				0,
				1
			)

			local value = math.floor(min + (max - min) * newPercent + 0.5)
			value = Clamp(value, min, max)
			currentValue = value
			percent = GetPercent(value)

			Fill.Size = UDim2.new(percent, 0, 1, 0)
			Handle.Position = UDim2.new(percent, -8, 0.5, -8)
			Label.Text = text .. ": " .. value

			if typeof(callback) == "function" then
				callback(value)
			end

			return value
		end

		Handle.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 then
				draggingSlider = true
			end
		end)

		Handle.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 then
				draggingSlider = false
			end
		end)

		Bar.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 then
				draggingSlider = true
				UpdateSlider(input)
			end
		end)

		ConnectGlobal(UIS.InputChanged, function(input)
			if draggingSlider and input.UserInputType == Enum.UserInputType.MouseMovement then
				UpdateSlider(input)
			end
		end)

		ConnectGlobal(UIS.InputEnded, function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 then
				draggingSlider = false
			end
		end)

		-- Return API
		local SliderAPI = {}
		function SliderAPI.SetValue(value)
			value = Clamp(math.floor((tonumber(value) or min) + 0.5), min, max)
			currentValue = value
			percent = GetPercent(value)
			Fill.Size = UDim2.new(percent, 0, 1, 0)
			Handle.Position = UDim2.new(percent, -8, 0.5, -8)
			Label.Text = text .. ": " .. value
			if typeof(callback) == "function" then callback(value) end
		end
		function SliderAPI.GetValue()
			return currentValue
		end

		return SliderAPI
	end

