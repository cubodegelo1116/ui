-- 7. PARAGRAPH
function CreateParagraph(parent, text)
    local Para = Instance.new("TextLabel")
    Para.Size = UDim2.new(1, -10, 0, 0)
    Para.BackgroundTransparency = 1
    Para.Text = text
    Para.TextColor3 = Config.SubTextColor
    Para.TextSize = 12
    Para.Font = Enum.Font.Gotham
    Para.TextXAlignment = Enum.TextXAlignment.Left
    Para.TextWrapped = true
    Para.TextYAlignment = Enum.TextYAlignment.Top
    Para.Parent = parent
    
    local textBounds = game:GetService("TextService"):GetTextSize(
        text,
        Para.TextSize,
        Para.Font,
        Vector2.new(Para.AbsoluteSize.X or 400, 1000)
    )
    Para.Size = UDim2.new(1, -10, 0, textBounds.Y + 8)
    
    return Para
end

-- =============================================
-- FUNÇÃO PARA MOSTRAR/ESCONDER
-- =============================================
function MyUILibrary:Toggle()
    MainFrame.Visible = not MainFrame.Visible
end

function MyUILibrary:Show()
    MainFrame.Visible = true
end

function MyUILibrary:Hide()
    MainFrame.Visible = false
end

-- =============================================
-- FUNÇÃO PARA MUDAR COR
-- =============================================
function MyUILibrary:SetColor(color)
    Config.PrimaryColor = color
    TitleBar.BackgroundColor3 = color
    ResizeHandle.BackgroundColor3 = color
    if SelectedTab then
        SelectedTab.Button.BackgroundColor3 = color
    end
end

-- =============================================
-- RETORNAR A BIBLIOTECA
-- =============================================
return MyUILibrary
