local TabList = {}
local SelectedTab = nil

-- =============================================
-- FUNÇÃO PARA SELECIONAR ABA
-- =============================================
local function SelectTab(tabData)
    if SelectedTab then
        SelectedTab.Button.BackgroundColor3 = Color3.fromRGB(40, 40, 45)
        SelectedTab.Button.TextColor3 = Color3.fromRGB(180, 180, 190)
        SelectedTab.Container.Visible = false
    end
    
    tabData.Button.BackgroundColor3 = Config.PrimaryColor
    tabData.Button.TextColor3 = Config.TextColor
    tabData.Container.Visible = true
    
    local totalHeight = 0
    for _, child in pairs(tabData.Container:GetChildren()) do
        if child:IsA("Frame") or child:IsA("TextLabel") then
            totalHeight = totalHeight + child.Size.Y.Offset + 6
        end
    end
    ContentScrolling.CanvasSize = UDim2.new(0, 0, 0, totalHeight + 20)
    
    SelectedTab = tabData
end

-- =============================================
-- CRIAR ABA
-- =============================================
function MyUILibrary:CreateTab(name)
    local TabButton = Instance.new("TextButton")
    TabButton.Size = UDim2.new(1, -10, 0, 35)
    TabButton.Position = UDim2.new(0, 5, 0, 0)
    TabButton.BackgroundColor3 = Color3.fromRGB(40, 40, 45)
    TabButton.BorderSizePixel = 0
    TabButton.Text = name
    TabButton.TextColor3 = Color3.fromRGB(180, 180, 190)
    TabButton.TextSize = 13
    TabButton.Font = Enum.Font.GothamSemibold
    TabButton.TextXAlignment = Enum.TextXAlignment.Left
    TabButton.Parent = SidebarScrolling
    
    TabButton.MouseEnter:Connect(function()
        if TabButton ~= SelectedTab?.Button then
            TabButton.BackgroundColor3 = Color3.fromRGB(50, 50, 60)
        end
    end)
    TabButton.MouseLeave:Connect(function()
        if TabButton ~= SelectedTab?.Button then
            TabButton.BackgroundColor3 = Color3.fromRGB(40, 40, 45)
        end
    end)
    
    local TabContainer = Instance.new("Frame")
    TabContainer.Size = UDim2.new(1, 0, 0, 0)
    TabContainer.BackgroundTransparency = 1
    TabContainer.Visible = false
    TabContainer.Parent = ContentScrolling
    
    local TabLayout = Instance.new("UIListLayout")
    TabLayout.Padding = UDim.new(0, 6)
    TabLayout.SortOrder = Enum.SortOrder.LayoutOrder
    TabLayout.Parent = TabContainer
    
    local tabData = {
        Button = TabButton,
        Container = TabContainer,
        Elements = {}
    }
    table.insert(TabList, tabData)
    
    SidebarScrolling.CanvasSize = UDim2.new(0, 0, 0, #TabList * 40 + 10)
    
    if not SelectedTab then
        SelectTab(tabData)
    end
    
    TabButton.MouseButton1Click:Connect(function()
        SelectTab(tabData)
    end)
    
    return {
        Button = function(label, callback)
            return CreateButton(TabContainer, label, callback)
        end,
        Dropdown = function(label, options, default, callback)
            return CreateDropdown(TabContainer, label, options, default, callback)
        end,
        Slider = function(label, min, max, default, callback)
            return CreateSlider(TabContainer, label, min, max, default, callback)
        end,
        CooldownButton = function(label, cooldown, callback)
            return CreateCooldownButton(TabContainer, label, cooldown, callback)
        end,
        Toggle = function(label, default, callback)
            return CreateToggle(TabContainer, label, default, callback)
        end,
        TextLabel = function(text)
            return CreateTextLabel(TabContainer, text)
        end,
        Paragraph = function(text)
            return CreateParagraph(TabContainer, text)
        end
    }
end

