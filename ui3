-- ════════════════════════════════════════════════════════════
-- UTILITY FUNCTIONS
-- ════════════════════════════════════════════════════════════

local function ValidateColor(color)
	if typeof(color) == "Color3" then
		return color
	end
	error("Expected Color3, got " .. typeof(color), 2)
end

local function ValidateString(value, allowNil)
	if allowNil and value == nil then return nil end
	if typeof(value) == "string" then return value end
	if typeof(value) == "number" then return tostring(value) end
	if allowNil then return "" end
	error("Expected string or number, got " .. typeof(value), 2)
end

local function Clamp(value, min, max)
	return math.min(math.max(value, min), max)
end

local function CopyTable(tbl)
	local copy = {}
	for k, v in pairs(tbl) do
		copy[k] = v
	end
	return copy
end

local function SafeWait(duration)
	if duration > 0 then
		task.wait(duration)
	end
end

