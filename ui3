function AddDropdown(page, text, options, callback)

	local Frame = Instance.new("Frame")

	Frame.Size = UDim2.new(1, 0, 0, 32)
	Frame.BackgroundTransparency = 1
	Frame.Parent = page

	local Btn = Instance.new("TextButton")

	Btn.Size = UDim2.new(1, 0, 1, 0)
	Btn.BackgroundColor3 = Theme.Button
	Btn.BorderSizePixel = 0
	Btn.TextColor3 = Theme.Text
	Btn.TextSize = 13
	Btn.Font = Enum.Font.Gotham
	Btn.TextXAlignment = Enum.TextXAlignment.Left
	Btn.AutoButtonColor = false
	Btn.Parent = Frame

	Btn:SetAttribute("ThemeRole", "Button")

	local Corner = Instance.new("UICorner")
	Corner.CornerRadius = UDim.new(0, 6)
	Corner.Parent = Btn

	local Stroke = Instance.new("UIStroke")
	Stroke.Color = Theme.Border
	Stroke.Thickness = 1
	Stroke.Parent = Btn

	Stroke:SetAttribute("ThemeRole", "Border")

	--==================================================
	-- ESTADO
	--==================================================

	local currentOptions = {}

	for _, option in ipairs(options or {}) do
		if typeof(option) == "string" then
			table.insert(currentOptions, option)
		else
			warn("Dropdown recebeu opção inválida:", option)
		end
	end

	local currentValue = currentOptions[1]
	local open = false

	--==================================================
	-- LISTA
	--==================================================

	local List = Instance.new("Frame")

	List.BackgroundColor3 = Theme.TitleBar
	List.BorderSizePixel = 0
	List.Visible = false
	List.ZIndex = 50
	List.Parent = ScreenGui

	List:SetAttribute("ThemeRole", "TitleBar")

	local ListCorner = Instance.new("UICorner")
	ListCorner.CornerRadius = UDim.new(0, 6)
	ListCorner.Parent = List

	local ListStroke = Instance.new("UIStroke")
	ListStroke.Color = Theme.Border
	ListStroke.Thickness = 1
	ListStroke.Parent = List

	ListStroke:SetAttribute("ThemeRole", "Border")

	local ListLayout = Instance.new("UIListLayout")
	ListLayout.SortOrder = Enum.SortOrder.LayoutOrder
	ListLayout.Parent = List

	--==================================================
	-- TEXTO
	--==================================================

	local function UpdateButtonText()

		if currentValue then
			Btn.Text = "  " .. tostring(text) .. ": " .. tostring(currentValue)
		else
			Btn.Text = "  " .. tostring(text) .. ": Nenhum"
		end

	end

	--==================================================
	-- REBUILD
	--==================================================

	local function RebuildOptions()

		-- Apaga SOMENTE os botões antigos
		for _, child in ipairs(List:GetChildren()) do
			if child:IsA("TextButton") then
				child:Destroy()
			end
		end

		-- Cria novamente
		for i, opt in ipairs(currentOptions) do

			local OptBtn = Instance.new("TextButton")

			OptBtn.Size = UDim2.new(1, 0, 0, 28)
			OptBtn.BackgroundTransparency = 1
			OptBtn.BackgroundColor3 = Theme.Button
			OptBtn.BorderSizePixel = 0

			OptBtn.Text = "  " .. tostring(opt)
			OptBtn.TextColor3 = Theme.Text
			OptBtn.TextSize = 13
			OptBtn.Font = Enum.Font.Gotham
			OptBtn.TextXAlignment = Enum.TextXAlignment.Left

			OptBtn.AutoButtonColor = false
			OptBtn.ZIndex = 51
			OptBtn.LayoutOrder = i

			OptBtn.Parent = List

			OptBtn.MouseEnter:Connect(function()
				OptBtn.BackgroundTransparency = 0
			end)

			OptBtn.MouseLeave:Connect(function()
				OptBtn.BackgroundTransparency = 1
			end)

			OptBtn.MouseButton1Click:Connect(function()

				currentValue = opt

				UpdateButtonText()

				open = false
				List.Visible = false

				if callback then
					callback(opt)
				end

			end)

		end

		-- Atualiza tamanho mesmo estando FECHADO
		List.Size = UDim2.new(
			0,
			Btn.AbsoluteSize.X,
			0,
			math.max(#currentOptions * 28, 28)
		)

	end

