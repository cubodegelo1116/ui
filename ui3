		local Tab = {}
		Tab.Page = Page
		Tab.Button = TabBtn
		Tab.Name = name

		Tab.AddButton = function(text, callback)
			return AddButton(Page, text, callback)
		end

		Tab.AddToggle = function(text, default, callback)
			return AddToggle(Page, text, default, callback)
		end

		Tab.AddSlider = function(text, min, max, default, callback)
			return AddSlider(Page, text, min, max, default, callback)
		end

		Tab.AddTextLabel = function(text)
			return AddTextLabel(Page, text)
		end

		Tab.AddParagraph = function(title, text)
			return AddParagraph(Page, title, text)
		end

		Tab.AddDropdown = function(text, options, callback)
			return AddDropdown(Page, text, options, callback)
		end

		Tab.AddCooldownButton = function(text, cooldown, callback)
			return AddCooldownButton(Page, text, cooldown, callback)
		end

		Tab.AddTextBox = function(placeholder, callback)
			return AddTextBox(Page, placeholder, callback)
		end

		Tab.AddColorPicker = function(text, defaultColor, callback)
			return AddColorPicker(Page, text, defaultColor, callback)
		end

		Tab.Notification = function(title, message, duration, kind)
			return ShowNotification(title, message, duration, kind)
		end

		-- Tab switching
		TabBtn.MouseButton1Click:Connect(function()
			if CurrentTab then
				CurrentTab.Page.Visible = false
				CurrentTab.Button.BackgroundColor3 = Theme.TabBackground
				CurrentTab.Button.TextColor3 = Theme.TextDark
				CurrentTab.Button:SetAttribute("ThemeRole", "TabBackground")
				local oldStroke = CurrentTab.Button:FindFirstChildOfClass("UIStroke")
				if oldStroke then oldStroke.Color = Theme.TabBorder end
			end

			Page.Visible = true
			TabBtn.BackgroundColor3 = Theme.TabSelected
			TabBtn.TextColor3 = Theme.Text
			TabBtn:SetAttribute("ThemeRole", "TabSelected")
			TabStroke.Color = Theme.Accent

			CurrentTab = Tab
		end)

		table.insert(Tabs, Tab)

		-- Reflow tabs using each button's measured height. The side panel scrolls if needed.
		local nextY = 8
		for _, tabItem in ipairs(Tabs) do
			tabItem.Button.Position = UDim2.new(0, 6, 0, nextY)
			nextY = nextY + tabItem.Button.Size.Y.Offset + 4
		end
		TabFrame.CanvasSize = UDim2.new(0, 0, 0, nextY + 4)

		-- Auto-select first tab
		if #Tabs == 1 then
			Page.Visible = true
			TabBtn.BackgroundColor3 = Theme.TabSelected
			TabBtn.TextColor3 = Theme.Text
			TabBtn:SetAttribute("ThemeRole", "TabSelected")
			TabStroke.Color = Theme.Accent
			CurrentTab = Tab
		end

		return Tab
	end

