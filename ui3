	local function AddMinimizeButton(config)
		config = config or {}

		local imageId = config.Image or "rbxassetid://7733960981"
		local size = config.Size or 50
		local imageSize = config.ImageSize or size * 0.55
		local corner = config.Corner or 1
		local transparency = config.Transparency or 0.25
		local position = config.Position or UDim2.new(0, 20, 0.5, -size / 2)

		local Ball = Instance.new("ImageButton")

		Ball.Size = UDim2.new(0, size, 0, size)
		Ball.Position = position
		Ball.BackgroundColor3 = Theme.TitleBar
		Ball.BackgroundTransparency = transparency
		Ball.Image = ""
		Ball.BorderSizePixel = 0
		Ball.Parent = ScreenGui

		Ball:SetAttribute("ThemeRole", "TitleBar")

		local BallCorner = Instance.new("UICorner")
		BallCorner.CornerRadius = UDim.new(corner, 0)
		BallCorner.Parent = Ball

		local BallStroke = Instance.new("UIStroke")
		BallStroke.Color = Theme.Border
		BallStroke.Thickness = 1.2
		BallStroke.Parent = Ball

		BallStroke:SetAttribute("ThemeRole", "Border")

		local Icon = Instance.new("ImageLabel")

		Icon.Size = UDim2.new(0, imageSize, 0, imageSize)

		Icon.Position = UDim2.new(
			0.5,
			-imageSize / 2,
			0.5,
			-imageSize / 2
		)

		Icon.BackgroundTransparency = 1
		Icon.Image = imageId
		Icon.ImageColor3 = Theme.Text
		Icon.Parent = Ball

		Icon:SetAttribute("ThemeRole", "Text")

		local ballDragging = false
		local ballStart
		local ballPos

		Ball.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 then
				ballDragging = true
				ballStart = input.Position
				ballPos = Ball.Position
			end
		end)

		Ball.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 then
				ballDragging = false
			end
		end)

		UIS.InputChanged:Connect(function(input)
			if ballDragging
				and input.UserInputType == Enum.UserInputType.MouseMovement then

				local delta = input.Position - ballStart

				Ball.Position = UDim2.new(
					ballPos.X.Scale,
					ballPos.X.Offset + delta.X,
					ballPos.Y.Scale,
					ballPos.Y.Offset + delta.Y
				)
			end
		end)

		local guiVisible = true

		Ball.MouseButton1Click:Connect(function()
			guiVisible = not guiVisible
			Main.Visible = guiVisible
		end)

		return Ball
	end

	--==================================================
	-- APPLY THEME
	--==================================================

	local function ApplyTheme()
		for _, object in ipairs(ScreenGui:GetDescendants()) do
			local role = object:GetAttribute("ThemeRole")

			if role then
				if role == "Background" then
					if object:IsA("GuiObject") then
						object.BackgroundColor3 = Theme.Background
					end

				elseif role == "TitleBar" then
					if object:IsA("GuiObject") then
						object.BackgroundColor3 = Theme.TitleBar
					end

				elseif role == "TabBackground" then
					if object:IsA("GuiObject") then
						object.BackgroundColor3 = Theme.TabBackground
					end

				elseif role == "TabSelected" then
					if object:IsA("GuiObject") then
						object.BackgroundColor3 = Theme.TabSelected
					end

				elseif role == "Button" then
					if object:IsA("GuiObject") then
						object.BackgroundColor3 = Theme.Button
					end

				elseif role == "ButtonHover" then
					if object:IsA("GuiObject") then
						object.BackgroundColor3 = Theme.ButtonHover
					end

				elseif role == "Text" then
					if object:IsA("TextLabel")
						or object:IsA("TextButton")
						or object:IsA("TextBox") then

						object.TextColor3 = Theme.Text

					elseif object:IsA("ImageLabel")
						or object:IsA("ImageButton") then

						object.ImageColor3 = Theme.Text
					end

				elseif role == "TextDark" then
					if object:IsA("TextLabel")
						or object:IsA("TextButton")
						or object:IsA("TextBox") then

						object.TextColor3 = Theme.TextDark
					end

				elseif role == "Accent" then
					if object:IsA("GuiObject") then
						object.BackgroundColor3 = Theme.Accent
					end

				elseif role == "ToggleOn" then
					if object:IsA("GuiObject") then
						object.BackgroundColor3 = Theme.ToggleOn
					end

				elseif role == "ToggleOff" then
					if object:IsA("GuiObject") then
						object.BackgroundColor3 = Theme.ToggleOff
					end

				elseif role == "Border" then
					if object:IsA("UIStroke") then
						object.Color = Theme.Border

					elseif object:IsA("GuiObject") then
						object.BackgroundColor3 = Theme.Border
					end
				end
			end
		end
	end

	--==================================================
	-- SET THEME
	--==================================================

	local function SetTheme(theme)
		local selectedTheme

		if typeof(theme) == "string" then
			selectedTheme = Themes[theme]

			if not selectedTheme then
				warn("UI: Tema '" .. theme .. "' não existe.")
				return false
			end

		elseif typeof(theme) == "table" then
			selectedTheme = theme
		else
			warn("UI: SetTheme recebeu um valor inválido.")
			return false
		end

		for key, value in pairs(selectedTheme) do
			if Theme[key] ~= nil then
				Theme[key] = value
			end
		end

		ApplyTheme()

		return true
	end

	--==================================================
	-- REGISTER THEME
	--==================================================

	local function RegisterTheme(name, colors)
		if not name then
			return nil
		end

		if type(colors) ~= "table" then
			warn("UI: cores do tema precisam ser uma tabela.")
			return nil
		end

		local newTheme = CopyTheme(Themes.Default)

		for key, value in pairs(colors) do
			if newTheme[key] ~= nil then
				newTheme[key] = value
			end
		end

		Themes[name] = newTheme

		return newTheme
	end

	--==================================================
	-- GET THEME
	--==================================================

	local function GetTheme(name)
		if name then
			return Themes[name]
		end

		return Theme
	end

	--==================================================
	-- GET ALL THEMES
	--==================================================

	local function GetThemes()
		local result = {}

		for name in pairs(Themes) do
			table.insert(result, name)
		end

		table.sort(result)

		return result
	end

