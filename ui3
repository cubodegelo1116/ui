		Accent.BorderSizePixel = 0
		Accent.ZIndex = 102
		Accent.Parent = Toast

		local TitleLabel = Instance.new("TextLabel")
		TitleLabel.Name = "Title"
		TitleLabel.Size = UDim2.new(1, -22, 0, 20)
		TitleLabel.Position = UDim2.new(0, 12, 0, 7)
