		TitleLabel.TextXAlignment = Enum.TextXAlignment.Left
		TitleLabel.TextTruncate = Enum.TextTruncate.AtEnd
		TitleLabel.ZIndex = 102
		TitleLabel.Parent = Toast
		TitleLabel:SetAttribute("ThemeRole", "Text")
		TitleLabel.TextStrokeTransparency = 1

		local MessageLabel = Instance.new("TextLabel")
		MessageLabel.Name = "Message"
		MessageLabel.Size = UDim2.new(1, -22, 0, 30)
		MessageLabel.Position = UDim2.new(0, 12, 0, 29)
		MessageLabel.BackgroundTransparency = 1
		MessageLabel.Text = message
		MessageLabel.TextColor3 = Theme.TextDark
		MessageLabel.TextSize = 11
		MessageLabel.Font = Enum.Font.Gotham
		MessageLabel.TextXAlignment = Enum.TextXAlignment.Left
		MessageLabel.TextYAlignment = Enum.TextYAlignment.Top
		MessageLabel.TextWrapped = true
		MessageLabel.TextTruncate = Enum.TextTruncate.AtEnd
		MessageLabel.ZIndex = 102
		MessageLabel.Parent = Toast
		MessageLabel:SetAttribute("ThemeRole", "TextDark")
		MessageLabel.TextStrokeTransparency = 1

		Toast.BackgroundTransparency = 1
		Accent.BackgroundTransparency = 1
		TitleLabel.TextTransparency = 1
		MessageLabel.TextTransparency = 1
		ToastStroke.Transparency = 1
		TweenService:Create(Toast, TweenInfo.new(0.18), {BackgroundTransparency = 0}):Play()
		TweenService:Create(Accent, TweenInfo.new(0.18), {BackgroundTransparency = 0}):Play()
		TweenService:Create(TitleLabel, TweenInfo.new(0.18), {TextTransparency = 0}):Play()
		TweenService:Create(MessageLabel, TweenInfo.new(0.18), {TextTransparency = 0}):Play()
		TweenService:Create(ToastStroke, TweenInfo.new(0.18), {Transparency = 0}):Play()

		task.delay(duration, function()
			if not Toast.Parent then return end
			TweenService:Create(Toast, TweenInfo.new(0.2), {BackgroundTransparency = 1}):Play()
			TweenService:Create(Accent, TweenInfo.new(0.2), {BackgroundTransparency = 1}):Play()
