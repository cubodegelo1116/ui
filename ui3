		CircleCorner.Parent = Circle

		Toggle.MouseButton1Click:Connect(function()
			state = not state

			local goalPos = state and UDim2.new(1, -19, 0.5, -8) or UDim2.new(0, 3, 0.5, -8)
			local goalColor = state and Theme.ToggleOn or Theme.ToggleOff

			Toggle:SetAttribute("ThemeRole", state and "ToggleOn" or "ToggleOff")

			TweenService:Create(Circle, TweenInfo.new(ANIMATION_SPEED), {Position = goalPos}):Play()
			TweenService:Create(Toggle, TweenInfo.new(ANIMATION_SPEED), {BackgroundColor3 = goalColor}):Play()

			if callback and typeof(callback) == "function" then
				callback(state)
			end
		end)

		-- Return API
		local ToggleAPI = {}
		function ToggleAPI.SetState(newState)
			if typeof(newState) == "boolean" and newState ~= state then
				Toggle.MouseButton1Click:Fire()
			end
		end
		function ToggleAPI.GetState()
			return state
		end

		return ToggleAPI
	end

	-- ─────────────────────────────────────────────────────────
	-- SLIDER COMPONENT
	-- ─────────────────────────────────────────────────────────

	function AddSlider(page, text, min, max, default, callback)
		if not page then error("Page required for AddSlider", 2) end
		text = ValidateString(text, true) or "Slider"
		min = tonumber(min) or 0
		max = tonumber(max) or 100
		default = tonumber(default) or min

		-- Validate ranges
		if min > max then min, max = max, min end
		default = Clamp(default, min, max)

		local Frame = Instance.new("Frame")
		Frame.Name = text
		Frame.Size = UDim2.new(1, 0, 0, 46)
		Frame.BackgroundTransparency = 1
		Frame.Parent = page

		local Label = Instance.new("TextLabel")
		Label.Size = UDim2.new(1, 0, 0, 18)
		Label.BackgroundTransparency = 1
		Label.Text = text .. ": " .. tostring(default)
		Label.TextColor3 = Theme.Text
		Label.TextSize = 13
		Label.Font = Enum.Font.Gotham
		Label.TextXAlignment = Enum.TextXAlignment.Left
		Label.TextYAlignment = Enum.TextYAlignment.Center
		Label.Parent = Frame
		Label:SetAttribute("ThemeRole", "Text")

		local Bar = Instance.new("Frame")
		Bar.Size = UDim2.new(1, 0, 0, 8)
		Bar.Position = UDim2.new(0, 0, 0, 28)
		Bar.BackgroundColor3 = Color3.fromRGB(35, 50, 58)
		Bar.BorderSizePixel = 0
		Bar.Parent = Frame

		local BarCorner = Instance.new("UICorner")
		BarCorner.CornerRadius = UDim.new(1, 0)
		BarCorner.Parent = Bar

		-- Calculate initial percent (safe from division by zero)
		local function GetPercent(value)
			if max == min then return 0 end
			return Clamp((value - min) / (max - min), 0, 1)
		end

		local percent = GetPercent(default)

		local Fill = Instance.new("Frame")
		Fill.Size = UDim2.new(percent, 0, 1, 0)
		Fill.BackgroundColor3 = Theme.Accent
		Fill.BorderSizePixel = 0
		Fill.Parent = Bar
		Fill:SetAttribute("ThemeRole", "Accent")

		local FillCorner = Instance.new("UICorner")
		FillCorner.CornerRadius = UDim.new(1, 0)
		FillCorner.Parent = Fill

		local Handle = Instance.new("Frame")
		Handle.Size = UDim2.new(0, 16, 0, 16)
		Handle.Position = UDim2.new(percent, -8, 0.5, -8)
		Handle.BackgroundColor3 = Color3.fromRGB(240, 240, 240)
		Handle.BorderSizePixel = 0
		Handle.ZIndex = 2
		Handle.Parent = Bar

		local HandleCorner = Instance.new("UICorner")
		HandleCorner.CornerRadius = UDim.new(1, 0)
		HandleCorner.Parent = Handle

		local draggingSlider = false

		local function UpdateSlider(input)
			if Bar.AbsoluteSize.X <= 0 then return end

			local newPercent = Clamp(
				(input.Position.X - Bar.AbsolutePosition.X) / Bar.AbsoluteSize.X,
				0,
				1
			)

			local value = math.floor(min + (max - min) * newPercent + 0.5)
			value = Clamp(value, min, max)

			Fill.Size = UDim2.new(newPercent, 0, 1, 0)
			Handle.Position = UDim2.new(newPercent, -8, 0.5, -8)
			Label.Text = text .. ": " .. value

			if callback and typeof(callback) == "function" then
				callback(value)
			end

			return value
		end

		Handle.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 then
				draggingSlider = true
			end
		end)

		Handle.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 then
				draggingSlider = false
			end
		end)

		Bar.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 then
				draggingSlider = true
				UpdateSlider(input)
			end
		end)

		UIS.InputChanged:Connect(function(input)
			if draggingSlider and input.UserInputType == Enum.UserInputType.MouseMovement then
				UpdateSlider(input)
			end
		end)

		UIS.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 then
				draggingSlider = false
			end
		end)

		-- Return API
		local SliderAPI = {}
		function SliderAPI.SetValue(value)
			value = tonumber(value) or min
			value = Clamp(value, min, max)
			local p = GetPercent(value)
			Fill.Size = UDim2.new(p, 0, 1, 0)
			Handle.Position = UDim2.new(p, -8, 0.5, -8)
			Label.Text = text .. ": " .. value
