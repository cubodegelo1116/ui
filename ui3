		Stroke:SetAttribute("ThemeRole", "Border")

		local onCooldown = false
		local cooldownRemaining = 0

		Btn.MouseButton1Click:Connect(function()
			if onCooldown then
				return
			end

			onCooldown = true
			cooldownRemaining = cooldown

			if callback and typeof(callback) == "function" then
				callback()
			end

			task.spawn(function()
				for i = cooldown, 1, -1 do
					Btn.Text = tostring(i)
					TweenService:Create(Btn, TweenInfo.new(0.1), {BackgroundColor3 = Theme.Cooldown}):Play()
					SafeWait(1)
				end

				Btn.Text = text
				TweenService:Create(Btn, TweenInfo.new(0.2), {BackgroundColor3 = Theme.Button}):Play()
				onCooldown = false
			end)
		end)

		-- API
		local CooldownAPI = {}
		function CooldownAPI.IsOnCooldown()
			return onCooldown
		end
		function CooldownAPI.ResetCooldown()
			onCooldown = false
			Btn.Text = text
			Btn.BackgroundColor3 = Theme.Button
		end

		return CooldownAPI
	end

