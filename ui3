		local Icon = Instance.new("ImageLabel")
		Icon.Size = UDim2.new(0, imageSize, 0, imageSize)
		Icon.Position = UDim2.new(0.5, -imageSize / 2, 0.5, -imageSize / 2)
		Icon.BackgroundTransparency = 1
		Icon.Image = imageId
		Icon.ImageColor3 = Theme.Text
		Icon.Parent = Ball
		Icon:SetAttribute("ThemeRole", "Text")

		local ballDragging = false
		local ballStart
		local ballPos

		Ball.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 then
				ballDragging = true
				ballStart = input.Position
				ballPos = Ball.Position
			end
		end)

		Ball.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 then
				ballDragging = false
			end
		end)

		ConnectGlobal(UIS.InputChanged, function(input)
			if ballDragging and input.UserInputType == Enum.UserInputType.MouseMovement then
				local delta = input.Position - ballStart
				Ball.Position = UDim2.new(
					ballPos.X.Scale,
					ballPos.X.Offset + delta.X,
					ballPos.Y.Scale,
					ballPos.Y.Offset + delta.Y
				)
			end
		end)

		local guiVisible = true

		Ball.MouseButton1Click:Connect(function()
			guiVisible = not guiVisible
			Main.Visible = guiVisible
		end)

		return Ball
	end

	-- ════════════════════════════════════════════════════════════
	-- THEME APPLICATION
	-- ════════════════════════════════════════════════════════════

	ApplyTheme = function()
		for _, object in ipairs(ScreenGui:GetDescendants()) do
			if object:IsA("TextLabel") or object:IsA("TextButton") or object:IsA("TextBox") then
				object.TextStrokeTransparency = 1
			end
			local role = object:GetAttribute("ThemeRole")

			if role then
				if role == "Background" then
					if object:IsA("GuiObject") then
						object.BackgroundColor3 = Theme.Background
					end

				elseif role == "TitleBar" then
					if object:IsA("GuiObject") then
						object.BackgroundColor3 = Theme.TitleBar
					end

				elseif role == "TabBackground" then
					if object:IsA("GuiObject") then
						object.BackgroundColor3 = Theme.TabBackground
					end

				elseif role == "TabSelected" then
					if object:IsA("GuiObject") then
						object.BackgroundColor3 = Theme.TabSelected
					end

				elseif role == "Button" then
					if object:IsA("GuiObject") then
						object.BackgroundColor3 = Theme.Button
					end
					if object:IsA("TextLabel") or object:IsA("TextButton") or object:IsA("TextBox") then
						object.TextColor3 = Theme.Text
						object.TextStrokeTransparency = 1
					end

				elseif role == "Text" then
					if object:IsA("TextLabel") or object:IsA("TextButton") or object:IsA("TextBox") then
						object.TextColor3 = Theme.Text
						object.TextStrokeTransparency = 1
					elseif object:IsA("ImageLabel") or object:IsA("ImageButton") then
						object.ImageColor3 = Theme.Text
					end

				elseif role == "TextDark" then
					if object:IsA("TextLabel") or object:IsA("TextButton") or object:IsA("TextBox") then
						object.TextColor3 = Theme.TextDark
						object.TextStrokeTransparency = 1
					end

				elseif role == "Accent" then
					if object:IsA("GuiObject") then
						object.BackgroundColor3 = Theme.Accent
					end

				elseif role == "ToggleOn" then
					if object:IsA("GuiObject") then
						object.BackgroundColor3 = Theme.ToggleOn
					end

				elseif role == "ToggleOff" then
					if object:IsA("GuiObject") then
						object.BackgroundColor3 = Theme.ToggleOff
					end

				elseif role == "Border" then
					if object:IsA("UIStroke") then
						object.Color = Theme.Border
					elseif object:IsA("GuiObject") then
						object.BackgroundColor3 = Theme.Border
					end

				elseif role == "TabBorder" then
					if object:IsA("UIStroke") then
						object.Color = Theme.TabBorder
						object.Thickness = 1 -- Borda visível das abas
					elseif object:IsA("GuiObject") then
						object.BackgroundColor3 = Theme.TabBorder
					end
				end
			end
		end
		
		-- Atualiza a cor do texto das tabs mesmo quando não estão selecionadas
		for _, tab in ipairs(Tabs) do
			if tab.Button then
				if tab == CurrentTab then
					tab.Button.TextColor3 = Theme.Text
				else
					tab.Button.TextColor3 = Theme.TextDark
				end
				tab.Button.TextStrokeTransparency = 1
				local tabStroke = tab.Button:FindFirstChildOfClass("UIStroke")
				if tabStroke then
					tabStroke.Thickness = 1
					tabStroke.Color = (tab == CurrentTab) and Theme.Accent or Theme.TabBorder
				end
			end
		end
	end

