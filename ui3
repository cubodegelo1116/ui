	function AddCooldownButton(page, text, cooldown, callback)
		if not page then error("Page required for AddCooldownButton", 2) end
		text = ValidateString(text, true) or "Button"
		cooldown = math.max(0, math.floor(tonumber(cooldown) or 5))

		local Btn = Instance.new("TextButton")
		Btn.Name = text
		Btn.Size = UDim2.new(1, 0, 0, 32)
		Btn.BackgroundColor3 = Theme.Button
		Btn.BorderSizePixel = 0
		Btn.Text = text
		Btn.TextColor3 = Theme.Text
		Btn.TextSize = 13
		Btn.Font = Enum.Font.Gotham
		Btn.AutoButtonColor = false
		Btn.Parent = page
		Btn:SetAttribute("ThemeRole", "Button")
		Btn.TextStrokeTransparency = 1

		local Corner = Instance.new("UICorner")
		Corner.CornerRadius = UDim.new(0, 3)
		Corner.Parent = Btn

		local Stroke = Instance.new("UIStroke")
		Stroke.Color = Theme.Border
		Stroke.Thickness = 1
		Stroke.Parent = Btn
		Stroke:SetAttribute("ThemeRole", "Border")

		local onCooldown = false
		local cooldownToken = 0

		Btn.MouseButton1Click:Connect(function()
			if onCooldown then return end

			onCooldown = true
			cooldownToken += 1
			local thisToken = cooldownToken

			if typeof(callback) == "function" then
				local ok, err = pcall(callback)
				if not ok then warn("UI cooldown callback error: " .. tostring(err)) end
			end

			task.spawn(function()
				for i = cooldown, 1, -1 do
					if thisToken ~= cooldownToken then return end
					Btn.Text = tostring(i)
					TweenService:Create(Btn, TweenInfo.new(0.1), {BackgroundColor3 = Theme.Cooldown}):Play()
					SafeWait(1)
				end

				if thisToken ~= cooldownToken then return end
				Btn.Text = text
				TweenService:Create(Btn, TweenInfo.new(0.2), {BackgroundColor3 = Theme.Button}):Play()
				onCooldown = false
			end)
		end)

		-- API
		local CooldownAPI = {}
		function CooldownAPI.IsOnCooldown()
			return onCooldown
		end
		function CooldownAPI.ResetCooldown()
			cooldownToken += 1
			onCooldown = false
			Btn.Text = text
			Btn.BackgroundColor3 = Theme.Button
		end

		return CooldownAPI
	end

