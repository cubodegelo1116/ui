-- 7. PARAGRAPH
function CreateParagraph(parent, text, color)
    local Para = Instance.new("TextLabel")
    Para.Size = UDim2.new(1, -20, 0, 0)
    Para.BackgroundTransparency = 1
    Para.Text = text
    Para.TextColor3 = color or Color3.fromRGB(180, 180, 190)
    Para.TextSize = 13
    Para.Font = Enum.Font.Gotham
    Para.TextXAlignment = Enum.TextXAlignment.Left
    Para.TextWrapped = true
    Para.TextYAlignment = Enum.TextYAlignment.Top
    Para.Parent = parent
    
    -- Ajustar altura baseada no texto
    local textBounds = game:GetService("TextService"):GetTextSize(
        text,
        Para.TextSize,
        Para.Font,
        Vector2.new(Para.AbsoluteSize.X or 500, 1000)
    )
    Para.Size = UDim2.new(1, -20, 0, textBounds.Y + 10)
    
    return Para
end

