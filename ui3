)
				List.Visible = true
			else
				List.Visible = false
			end
		end)

		-- Close dropdown when clicking outside
		UserInputService.InputBegan:Connect(function(input, gameProcessed)
			if input.UserInputType == Enum.UserInputType.MouseButton1 then
				if open then
					local mousePos = input.Position
					local listRect = List.AbsolutePosition + List.AbsoluteSize
					
					if mousePos.X < List.AbsolutePosition.X or 
					   mousePos.X > listRect.X or
					   mousePos.Y < List.AbsolutePosition.Y or
					   mousePos.Y > listRect.Y then
						open = false
						List.Visible = false
					end
				end
			end
		end)

		-- API
		local DropdownAPI = {}

		function DropdownAPI.SetOptions(newOptions)
			if typeof(newOptions) ~= "table" then
				warn("Dropdown:SetOptions - expected table")
				return false
			end

			currentOptions = {}
			for _, opt in ipairs(newOptions) do
				if typeof(opt) == "string" then
					table.insert(currentOptions, opt)
				end
			end

			if not table.find(currentOptions, currentValue) then
				currentValue = currentOptions[1]
			end

			UpdateButtonText()
			RebuildOptions()
			return true
		end

		function DropdownAPI.SetValue(value)
			if typeof(value) ~= "string" then return false end
			if not table.find(currentOptions, value) then return false end

			currentValue = value
			UpdateButtonText()

			if callback and typeof(callback) == "function" then
				callback(value)
			end

			return true
		end

		function DropdownAPI.GetValue()
			return currentValue
		end

