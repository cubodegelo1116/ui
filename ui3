		ListCorner.Parent = List

		local ListStroke = Instance.new("UIStroke")
		ListStroke.Color = Theme.Border
		ListStroke.Thickness = 1
		ListStroke.Parent = List
		ListStroke:SetAttribute("ThemeRole", "Border")

		local ListLayout = Instance.new("UIListLayout")
		ListLayout.SortOrder = Enum.SortOrder.LayoutOrder
		ListLayout.Padding = UDim.new(0, 0)
		ListLayout.Parent = List

		local ListPadding = Instance.new("UIPadding")
		ListPadding.PaddingTop = UDim.new(0, 2)
		ListPadding.PaddingBottom = UDim.new(0, 2)
		ListPadding.Parent = List

		-- Update button text
		local function UpdateButtonText()
			if currentValue then
				Btn.Text = "  " .. text .. ": " .. tostring(currentValue)
			else
				Btn.Text = "  " .. text .. ": Nenhum"
			end
		end

		-- Rebuild options list
		local function RebuildOptions()
			for _, child in ipairs(List:GetChildren()) do
				if child:IsA("TextButton") then
					child:Destroy()
				end
			end

			for i, opt in ipairs(currentOptions) do
				local OptBtn = Instance.new("TextButton")
				OptBtn.Size = UDim2.new(1, -4, 0, DROPDOWN_ITEM_HEIGHT)
				OptBtn.BackgroundTransparency = 1
				OptBtn.BackgroundColor3 = Theme.Button
				OptBtn.BorderSizePixel = 0
				OptBtn.Text = "  " .. tostring(opt)
				OptBtn.TextColor3 = Theme.Text
				OptBtn.TextSize = 13
				OptBtn.Font = Enum.Font.Gotham
				OptBtn.TextXAlignment = Enum.TextXAlignment.Left
				OptBtn.AutoButtonColor = false
				OptBtn.ZIndex = 51
				OptBtn.LayoutOrder = i
				OptBtn.Parent = List
				OptBtn:SetAttribute("ThemeRole", "Text")
				OptBtn.TextStrokeTransparency = 1

				OptBtn.MouseEnter:Connect(function()
					TweenService:Create(OptBtn, TweenInfo.new(0.1), {BackgroundColor3 = Theme.DropdownHover, BackgroundTransparency = 0}):Play()
				end)

				OptBtn.MouseLeave:Connect(function()
					TweenService:Create(OptBtn, TweenInfo.new(0.1), {BackgroundTransparency = 1}):Play()
				end)

				OptBtn.MouseButton1Click:Connect(function()
					currentValue = opt
					UpdateButtonText()
					open = false
					List.Visible = false

					if callback and typeof(callback) == "function" then
						callback(opt)
					end
				end)
			end

			local listHeight = math.min(
				#currentOptions * DROPDOWN_ITEM_HEIGHT + 4,
				DROPDOWN_MAX_HEIGHT
			)
			List.Size = UDim2.new(0, Btn.AbsoluteSize.X, 0, listHeight)
		end

		local function UpdateListPosition()
			if not open then return end
			local absPos = Btn.AbsolutePosition
			local absSize = Btn.AbsoluteSize
			List.Position = UDim2.fromOffset(absPos.X, absPos.Y + absSize.Y + 4)
			List.Size = UDim2.new(0, absSize.X, 0, math.min(#currentOptions * DROPDOWN_ITEM_HEIGHT + 4, DROPDOWN_MAX_HEIGHT))
		end

		Main:GetPropertyChangedSignal("Position"):Connect(UpdateListPosition)
		Main:GetPropertyChangedSignal("Size"):Connect(UpdateListPosition)

		-- Initialize
		UpdateButtonText()
		RebuildOptions()

		-- Toggle dropdown
		Btn.MouseButton1Click:Connect(function()
			open = not open

			if open then
				UpdateListPosition()
				List.Visible = #currentOptions > 0
			else
				List.Visible = false
			end
		end)

		-- Close dropdown when clicking outside
		ConnectGlobal(UIS.InputBegan, function(input)
			if input.UserInputType ~= Enum.UserInputType.MouseButton1 or not open then
				return
			end

			local mousePos = input.Position
			local buttonPos = Btn.AbsolutePosition
			local buttonSize = Btn.AbsoluteSize
			local listPos = List.AbsolutePosition
			local listSize = List.AbsoluteSize

			local insideButton = mousePos.X >= buttonPos.X and mousePos.X <= buttonPos.X + buttonSize.X
				and mousePos.Y >= buttonPos.Y and mousePos.Y <= buttonPos.Y + buttonSize.Y
			local insideList = mousePos.X >= listPos.X and mousePos.X <= listPos.X + listSize.X
				and mousePos.Y >= listPos.Y and mousePos.Y <= listPos.Y + listSize.Y

			if not insideButton and not insideList then
				open = false
				List.Visible = false
			end
		end)

		-- API
		local DropdownAPI = {}

		function DropdownAPI.SetOptions(newOptions)
			if typeof(newOptions) ~= "table" then
				warn("Dropdown:SetOptions - expected table")
				return false
			end

			currentOptions = {}
			for _, opt in ipairs(newOptions) do
				if typeof(opt) == "string" then
					table.insert(currentOptions, opt)
				end
			end

			if not table.find(currentOptions, currentValue) then
				currentValue = currentOptions[1]
			end

			UpdateButtonText()
			RebuildOptions()
			return true
		end

		function DropdownAPI.SetValue(value)
			if typeof(value) ~= "string" then return false end
			if not table.find(currentOptions, value) then return false end

			currentValue = value
			UpdateButtonText()

			if callback and typeof(callback) == "function" then
				callback(value)
			end

			return true
		end

		function DropdownAPI.GetValue()
			return currentValue
		end

		function DropdownAPI.GetOptions()
			return CopyTable(currentOptions)
		end

		return DropdownAPI
	end

