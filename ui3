        local function UpdateColor(shouldNotify)
            hue = Clamp(hue, 0, 1)
            saturation = Clamp(saturation, 0, 1)
            value = Clamp(value, 0, 1)
            currentColor = Color3.fromHSV(hue, saturation, value)
            local hex = Hex(currentColor)
            HexLabel.Text = hex
            PopupHex.Text = hex
            Swatch.BackgroundColor3 = currentColor
            Preview.BackgroundColor3 = currentColor
            SVField.BackgroundColor3 = Color3.fromHSV(hue, 1, 1)
            SVMarker.Position = UDim2.new(saturation, 0, 1 - value, 0)
            HueHandle.Position = UDim2.new(0.5, 0, hue, 0)
            if shouldNotify ~= false and typeof(callback) == "function" then
                callback(currentColor)
            end
        end

        local function SetSVFromScreen(screenX, screenY)
            if SVField.AbsoluteSize.X <= 0 or SVField.AbsoluteSize.Y <= 0 then return end
            saturation = Clamp((screenX - SVField.AbsolutePosition.X) / SVField.AbsoluteSize.X, 0, 1)
            value = 1 - Clamp((screenY - SVField.AbsolutePosition.Y) / SVField.AbsoluteSize.Y, 0, 1)
            UpdateColor(true)
        end

        local function SetHueFromScreen(screenY)
            if HueBar.AbsoluteSize.Y <= 0 then return end
            hue = Clamp((screenY - HueBar.AbsolutePosition.Y) / HueBar.AbsoluteSize.Y, 0, 1)
            UpdateColor(true)
        end

        local function BeginSV(input)
            if input.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
            activeDrag = "sv"
            SetSVFromScreen(input.Position.X, input.Position.Y)
        end
        for _, object in ipairs({SVField, WhiteOverlay, BlackOverlay, SVMarker}) do
            object.InputBegan:Connect(BeginSV)
        end
        HueBar.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then
                activeDrag = "hue"
                SetHueFromScreen(input.Position.Y)
            end
        end)
        HueHandle.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then
                activeDrag = "hue"
                SetHueFromScreen(input.Position.Y)
            end
        end)

        local function UpdatePopupPosition()
            if not Popup.Visible then return end
            local pos = PickerButton.AbsolutePosition
            local size = PickerButton.AbsoluteSize
            local camera = workspace.CurrentCamera
            local viewport = camera and camera.ViewportSize or Vector2.new(1024, 768)
            local popupWidth, popupHeight = 314, 226
            local x = Clamp(pos.X + size.X - popupWidth, 6, math.max(6, viewport.X - popupWidth - 6))
            local y = pos.Y + size.Y + 4
            if y + popupHeight > viewport.Y - 6 then
                y = math.max(6, pos.Y - popupHeight - 4)
            end
            Popup.Position = UDim2.fromOffset(x, y)
        end

        local function SetOpen(open)
            Popup.Visible = open == true and Main.Visible and page.Visible
            if Popup.Visible then UpdatePopupPosition() end
        end

        page:GetPropertyChangedSignal("Visible"):Connect(function()
            if not page.Visible then SetOpen(false) end
        end)
        Main:GetPropertyChangedSignal("Visible"):Connect(function()
            if not Main.Visible then SetOpen(false) end
        end)
        PickerButton.MouseButton1Click:Connect(function()
            SetOpen(not Popup.Visible)
        end)
        CloseButton.MouseButton1Click:Connect(function()
            SetOpen(false)
        end)

        ConnectGlobal(UIS.InputChanged, function(input)
            if not Popup.Visible or input.UserInputType ~= Enum.UserInputType.MouseMovement then return end
            if activeDrag == "sv" then
                SetSVFromScreen(input.Position.X, input.Position.Y)
            elseif activeDrag == "hue" then
                SetHueFromScreen(input.Position.Y)
            end
        end)
        ConnectGlobal(UIS.InputEnded, function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then
                activeDrag = nil
            end
        end)
        ConnectGlobal(UIS.InputBegan, function(input)
            if not Popup.Visible or input.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
            local p = input.Position
            local popupPos, popupSize = Popup.AbsolutePosition, Popup.AbsoluteSize
            local btnPos, btnSize = PickerButton.AbsolutePosition, PickerButton.AbsoluteSize
            local insidePopup = p.X >= popupPos.X and p.X <= popupPos.X + popupSize.X
                and p.Y >= popupPos.Y and p.Y <= popupPos.Y + popupSize.Y
            local insideButton = p.X >= btnPos.X and p.X <= btnPos.X + btnSize.X
                and p.Y >= btnPos.Y and p.Y <= btnPos.Y + btnSize.Y
            if not insidePopup and not insideButton then SetOpen(false) end
        end)
        PickerButton:GetPropertyChangedSignal("AbsolutePosition"):Connect(UpdatePopupPosition)
        Main:GetPropertyChangedSignal("Position"):Connect(UpdatePopupPosition)
        Main:GetPropertyChangedSignal("Size"):Connect(UpdatePopupPosition)

        local function ApplyColor(color, shouldNotify)
            if typeof(color) ~= "Color3" then return false end
            hue, saturation, value = color:ToHSV()
            UpdateColor(shouldNotify)
            return true
        end

        UpdateColor(false)
        local PickerAPI = {}
        function PickerAPI.GetColor() return currentColor end
        function PickerAPI.GetHex() return Hex(currentColor) end
        function PickerAPI.SetColor(color, shouldNotify)
            return ApplyColor(color, shouldNotify ~= false)
        end
        function PickerAPI.Open() SetOpen(true) end
        function PickerAPI.Close() SetOpen(false) end
        return PickerAPI
    end

