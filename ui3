	local DropdownAPI = {}

	function DropdownAPI.SetOptions(newOptions)

		if typeof(newOptions) ~= "table" then
			warn("Dropdown:SetOptions recebeu algo que não é tabela.")
			return
		end

		currentOptions = {}

		-- Filtra e garante STRING
		for _, option in ipairs(newOptions) do

			if typeof(option) == "string" then
				table.insert(currentOptions, option)

			else
				warn(
					"Dropdown:SetOptions ignorou opção inválida:",
					option
				)

			end

		end

		-- Mantém seleção se ainda existir
		if currentValue
			and table.find(currentOptions, currentValue) then

			-- mantém

		else
			currentValue = currentOptions[1]
		end

		-- ATUALIZA MESMO FECHADO
		UpdateButtonText()
		RebuildOptions()

	end

	function DropdownAPI.SetValue(value)

		if typeof(value) ~= "string" then
			return false
		end

		if not table.find(currentOptions, value) then
			return false
		end

		currentValue = value

		UpdateButtonText()

		if callback then
			callback(value)
		end

		return true

	end

	function DropdownAPI.GetValue()
		return currentValue
	end

	function DropdownAPI.GetOptions()
		return currentOptions
	end

	return DropdownAPI

end
