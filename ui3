		Btn.BorderSizePixel = 0
		Btn.Text = "  " .. text .. ": " .. (options[1] or "")
		Btn.TextColor3 = Theme.Text
		Btn.TextSize = 13
		Btn.Font = Enum.Font.Gotham
		Btn.TextXAlignment = Enum.TextXAlignment.Left
		Btn.AutoButtonColor = false
		Btn.Parent = Frame

		local Corner = Instance.new("UICorner")
		Corner.CornerRadius = UDim.new(0, 6)
		Corner.Parent = Btn

		local Stroke = Instance.new("UIStroke")
		Stroke.Color = Theme.Border
		Stroke.Thickness = 1
		Stroke.Parent = Btn

		local open = false
		local List = Instance.new("Frame")
		List.Size = UDim2.new(0, 200, 0, #options * 28)
		List.BackgroundColor3 = Theme.TitleBar
		List.BorderSizePixel = 0
		List.Visible = false
		List.ZIndex = 50
		List.Parent = ScreenGui

		local ListCorner = Instance.new("UICorner")
		ListCorner.CornerRadius = UDim.new(0, 6)
		ListCorner.Parent = List

		local ListStroke = Instance.new("UIStroke")
		ListStroke.Color = Theme.Border
		ListStroke.Thickness = 1
		ListStroke.Parent = List

		for i, opt in ipairs(options) do
			local OptBtn = Instance.new("TextButton")
			OptBtn.Size = UDim2.new(1, 0, 0, 28)
			OptBtn.Position = UDim2.new(0, 0, 0, (i-1)*28)
			OptBtn.BackgroundTransparency = 1
			OptBtn.Text = "  " .. opt
			OptBtn.TextColor3 = Theme.Text
			OptBtn.TextSize = 13
			OptBtn.Font = Enum.Font.Gotham
			OptBtn.TextXAlignment = Enum.TextXAlignment.Left
			OptBtn.ZIndex = 51
			OptBtn.Parent = List

			OptBtn.MouseButton1Click:Connect(function()
				Btn.Text = "  " .. text .. ": " .. opt
				List.Visible = false
				open = false
				if callback then callback(opt) end
			end)
		end

		Btn.MouseButton1Click:Connect(function()
			open = not open
			if open then
				local absPos = Btn.AbsolutePosition
				local absSize = Btn.AbsoluteSize
				List.Position = UDim2.new(0, absPos.X, 0, absPos.Y + absSize.Y + 4)
				List.Size = UDim2.new(0, absSize.X, 0, #options * 28)
				List.Visible = true
			else
				List.Visible = false
			end
		end)

		return Btn
	end

	local function AddCooldownButton(page, text, cooldown, callback)
		local Btn = Instance.new("TextButton")
		Btn.Size = UDim2.new(1, 0, 0, 32)
		Btn.BackgroundColor3 = Theme.Button
		Btn.BorderSizePixel = 0
		Btn.Text = text
		Btn.TextColor3 = Theme.Text
		Btn.TextSize = 13
		Btn.Font = Enum.Font.Gotham
		Btn.AutoButtonColor = false
		Btn.Parent = page

		local Corner = Instance.new("UICorner")
		Corner.CornerRadius = UDim.new(0, 6)
		Corner.Parent = Btn

		local Stroke = Instance.new("UIStroke")
		Stroke.Color = Theme.Border
		Stroke.Thickness = 1
		Stroke.Parent = Btn

		local onCooldown = false
		Btn.MouseButton1Click:Connect(function()
			if onCooldown then return end
			onCooldown = true
			Btn.Text = tostring(cooldown)
			Btn.BackgroundColor3 = Theme.Cooldown
			if callback then callback() end

			task.spawn(function()
				for i = cooldown, 1, -1 do
					Btn.Text = tostring(i)
					task.wait(1)
				end
				Btn.Text = text
				Btn.BackgroundColor3 = Theme.Button
				onCooldown = false
			end)
		end)
		return Btn
	end

	-- Bolinha de minimizar (com ImageSize)
	local function AddMinimizeButton(config)
		config = config or {}
		local imageId = config.Image or "rbxassetid://7733960981"
		local size = config.Size or 50
		local imageSize = config.ImageSize or size * 0.55
		local corner = config.Corner or 1
		local transparency = config.Transparency or 0.25
		local position = config.Position or UDim2.new(0, 20, 0.5, -size/2)

		local Ball = Instance.new("ImageButton")
		Ball.Size = UDim2.new(0, size, 0, size)
		Ball.Position = position
		Ball.BackgroundColor3 = Theme.TitleBar
		Ball.BackgroundTransparency = transparency
		Ball.Image = ""
		Ball.BorderSizePixel = 0
		Ball.Parent = ScreenGui

		local BallCorner = Instance.new("UICorner")
		BallCorner.CornerRadius = UDim.new(corner, 0)
		BallCorner.Parent = Ball

		local BallStroke = Instance.new("UIStroke")
		BallStroke.Color = Theme.Border
		BallStroke.Thickness = 1.2
		BallStroke.Parent = Ball

		local Icon = Instance.new("ImageLabel")
		Icon.Size = UDim2.new(0, imageSize, 0, imageSize)
		Icon.Position = UDim2.new(0.5, -imageSize/2, 0.5, -imageSize/2)
		Icon.BackgroundTransparency = 1
		Icon.Image = imageId
		Icon.ImageColor3 = Theme.Text
		Icon.Parent = Ball

		-- Drag da bolinha
		local ballDragging, ballStart, ballPos
		Ball.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 then
				ballDragging = true
				ballStart = input.Position
				ballPos = Ball.Position
			end
		end)
		Ball.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 then
				ballDragging = false
			end
		end)
		UIS.InputChanged:Connect(function(input)
			if ballDragging and input.UserInputType == Enum.UserInputType.MouseMovement then
				local delta = input.Position - ballStart
				Ball.Position = UDim2.new(ballPos.X.Scale, ballPos.X.Offset + delta.X, ballPos.Y.Scale, ballPos.Y.Offset + delta.Y)
			end
		end)

		local guiVisible = true
		Ball.MouseButton1Click:Connect(function()
			guiVisible = not guiVisible
			Main.Visible = guiVisible
		end)

		return Ball
	end

	local function SetTheme(newTheme)
		for k, v in pairs(newTheme) do
			if Theme[k] then Theme[k] = v end
		end
		Main.BackgroundColor3 = Theme.Background
		MainStroke.Color = Theme.Border
		TitleBar.BackgroundColor3 = Theme.TitleBar
		TitleBottom.BackgroundColor3 = Theme.TitleBar
		Title.TextColor3 = Theme.Text
		TabFrame.BackgroundColor3 = Theme.TabBackground
		Content.BackgroundColor3 = Theme.Background
		Resize.BackgroundColor3 = Theme.Border
	end

	return {
		CreateTab = CreateTab,
		AddButton = AddButton,
		AddToggle = AddToggle,
		AddSlider = AddSlider,
		AddTextLabel = AddTextLabel,
		AddParagraph = AddParagraph,
		AddDropdown = AddDropdown,
		AddCooldownButton = AddCooldownButton,
		AddMinimizeButton = AddMinimizeButton,
		SetTheme = SetTheme,
		Theme = Theme,
		Main = Main
	}
end

return UI
