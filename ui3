local UI = {}

function UI.CreateWindow(title, subtitle)
	local UIS = game:GetService("UserInputService")
	local TweenService = game:GetService("TweenService")

	--==================================================
	-- THEME BASE
	--==================================================

	local Theme = {
		Background = Color3.fromRGB(18, 28, 32),
		TitleBar = Color3.fromRGB(22, 35, 40),
		TabBackground = Color3.fromRGB(15, 24, 28),
		TabSelected = Color3.fromRGB(30, 50, 58),
		Button = Color3.fromRGB(28, 45, 52),
		ButtonHover = Color3.fromRGB(35, 55, 65),
		Text = Color3.fromRGB(230, 240, 245),
		TextDark = Color3.fromRGB(140, 160, 170),
		Accent = Color3.fromRGB(0, 180, 200),
		ToggleOn = Color3.fromRGB(0, 190, 140),
		ToggleOff = Color3.fromRGB(45, 60, 68),
		Border = Color3.fromRGB(40, 65, 75),
		Cooldown = Color3.fromRGB(160, 50, 50),
	}

	--==================================================
	-- THEME SYSTEM
	--==================================================

	local Themes = {}

	local function CopyTheme(theme)
		local copy = {}

		for k, v in pairs(theme) do
			copy[k] = v
		end

		return copy
	end

	Themes.Default = CopyTheme(Theme)

	local function CreateTheme(name, colors)
		if not name then
			return nil
		end

		local NewTheme = CopyTheme(Theme)

		if colors then
			for key, value in pairs(colors) do
				if NewTheme[key] ~= nil then
					NewTheme[key] = value
				end
			end
		end

		Themes[name] = NewTheme

		return NewTheme
	end

	--==================================================
	-- SCREEN GUI
	--==================================================

	local ScreenGui = Instance.new("ScreenGui")
	ScreenGui.Name = "UI"
	ScreenGui.ResetOnSpawn = false
	ScreenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	ScreenGui.Parent = game.Players.LocalPlayer:WaitForChild("PlayerGui")

	--==================================================
	-- MAIN
	--==================================================

	local Main = Instance.new("Frame")
	Main.Size = UDim2.new(0, 520, 0, 380)
	Main.Position = UDim2.new(0.5, -260, 0.5, -190)
	Main.BackgroundColor3 = Theme.Background
	Main.BorderSizePixel = 0
	Main.Active = true
	Main.ClipsDescendants = true
	Main.Parent = ScreenGui

	Main:SetAttribute("ThemeRole", "Background")

	local MainCorner = Instance.new("UICorner")
	MainCorner.CornerRadius = UDim.new(0, 10)
	MainCorner.Parent = Main

	local MainStroke = Instance.new("UIStroke")
	MainStroke.Color = Theme.Border
	MainStroke.Thickness = 1.2
	MainStroke.Parent = Main

	MainStroke:SetAttribute("ThemeRole", "Border")

	--==================================================
	-- TITLE BAR
	--==================================================

	local TitleBar = Instance.new("Frame")
	TitleBar.Size = UDim2.new(1, 0, 0, 36)
	TitleBar.BackgroundColor3 = Theme.TitleBar
	TitleBar.BorderSizePixel = 0
	TitleBar.Parent = Main

	TitleBar:SetAttribute("ThemeRole", "TitleBar")

	local TitleCorner = Instance.new("UICorner")
	TitleCorner.CornerRadius = UDim.new(0, 10)
	TitleCorner.Parent = TitleBar

	local TitleBottom = Instance.new("Frame")
	TitleBottom.Size = UDim2.new(1, 0, 0, 10)
	TitleBottom.Position = UDim2.new(0, 0, 1, -10)
	TitleBottom.BackgroundColor3 = Theme.TitleBar
	TitleBottom.BorderSizePixel = 0
	TitleBottom.Parent = TitleBar

	TitleBottom:SetAttribute("ThemeRole", "TitleBar")

--==================================================
-- TITLE + SUBTITLE
--==================================================

local Title = Instance.new("TextLabel")
Title.Size = UDim2.new(0, 180, 1, 0)
Title.Position = UDim2.new(0, 14, 0, 0)
Title.BackgroundTransparency = 1
Title.Text = title or "Cartola Hub"
Title.TextColor3 = Theme.Text
Title.TextSize = 15
Title.Font = Enum.Font.GothamMedium
Title.TextXAlignment = Enum.TextXAlignment.Left
Title.Parent = TitleBar

local Subtitle = Instance.new("TextLabel")
Subtitle.Size = UDim2.new(0, 180, 1, 0)
Subtitle.Position = UDim2.new(0, 14 + 180, 0, 0)
Subtitle.BackgroundTransparency = 1
Subtitle.Text = subtitle and ("  " .. subtitle) or ""
Subtitle.TextColor3 = Theme.TextDark
Subtitle.TextSize = 12
Subtitle.Font = Enum.Font.Gotham
Subtitle.TextXAlignment = Enum.TextXAlignment.Left
Subtitle.Parent = TitleBar

	Title:SetAttribute("ThemeRole", "Text")

	--==================================================
	-- MINIMIZE
	--==================================================

	local Minimize = Instance.new("TextButton")
	Minimize.Size = UDim2.new(0, 32, 0, 32)
	Minimize.Position = UDim2.new(1, -68, 0, 2)
	Minimize.BackgroundTransparency = 1
	Minimize.Text = "−"
	Minimize.TextColor3 = Theme.TextDark
	Minimize.TextSize = 20
	Minimize.Font = Enum.Font.GothamBold
	Minimize.Parent = TitleBar

	Minimize:SetAttribute("ThemeRole", "TextDark")

	--==================================================
	-- CLOSE
	--==================================================

	local Close = Instance.new("TextButton")
	Close.Size = UDim2.new(0, 32, 0, 32)
	Close.Position = UDim2.new(1, -34, 0, 2)
	Close.BackgroundTransparency = 1
	Close.Text = "×"
	Close.TextColor3 = Theme.TextDark
	Close.TextSize = 20
	Close.Font = Enum.Font.GothamBold
	Close.Parent = TitleBar

	Close:SetAttribute("ThemeRole", "TextDark")

	Close.MouseButton1Click:Connect(function()
		ScreenGui:Destroy()
	end)

	--==================================================
	-- DRAG
	--==================================================

	local dragging = false
	local dragStart
	local startPos

	TitleBar.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = true
			dragStart = input.Position
			startPos = Main.Position
		end
	end)

	TitleBar.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = false
		end
	end)

	UIS.InputChanged:Connect(function(input)
		if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
			local delta = input.Position - dragStart

			Main.Position = UDim2.new(
				startPos.X.Scale,
				startPos.X.Offset + delta.X,
				startPos.Y.Scale,
				startPos.Y.Offset + delta.Y
			)
		end
	end)

	--==================================================
	-- RESIZE
	--==================================================

	local Resize = Instance.new("TextButton")
	Resize.Size = UDim2.new(0, 12, 0, 12)
	Resize.Position = UDim2.new(1, -12, 1, -12)
	Resize.BackgroundColor3 = Theme.Border
	Resize.BackgroundTransparency = 0.6
	Resize.BorderSizePixel = 0
	Resize.Text = ""
	Resize.AutoButtonColor = false
	Resize.Parent = Main

	Resize:SetAttribute("ThemeRole", "Border")

	local ResizeCorner = Instance.new("UICorner")
	ResizeCorner.CornerRadius = UDim.new(0, 3)
	ResizeCorner.Parent = Resize

	local resizing = false
	local resizeStart
	local startSize

	Resize.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			resizing = true
			resizeStart = input.Position
			startSize = Main.Size
		end
	end)

	Resize.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			resizing = false
		end
	end)

	UIS.InputChanged:Connect(function(input)
		if resizing and input.UserInputType == Enum.UserInputType.MouseMovement then
			local delta = input.Position - resizeStart

			local newX = math.clamp(
				startSize.X.Offset + delta.X,
				380,
				900
			)

			local newY = math.clamp(
				startSize.Y.Offset + delta.Y,
				250,
				700
			)

			Main.Size = UDim2.new(0, newX, 0, newY)
		end
	end)

	--==================================================
	-- TABS / CONTENT
	--==================================================

	local TabFrame = Instance.new("Frame")
	TabFrame.Size = UDim2.new(0, 110, 1, -36)
	TabFrame.Position = UDim2.new(0, 0, 0, 36)
	TabFrame.BackgroundColor3 = Theme.TabBackground
	TabFrame.BorderSizePixel = 0
	TabFrame.Parent = Main

	TabFrame:SetAttribute("ThemeRole", "TabBackground")

	local TabCorner = Instance.new("UICorner")
	TabCorner.CornerRadius = UDim.new(0, 10)
	TabCorner.Parent = TabFrame

	local Content = Instance.new("Frame")
	Content.Size = UDim2.new(1, -110, 1, -36)
	Content.Position = UDim2.new(0, 110, 0, 36)
	Content.BackgroundColor3 = Theme.Background
	Content.BorderSizePixel = 0
	Content.Parent = Main

	Content:SetAttribute("ThemeRole", "Background")

	local ContentCorner = Instance.new("UICorner")
	ContentCorner.CornerRadius = UDim.new(0, 10)
	ContentCorner.Parent = Content

	--==================================================
	-- MINIMIZE LOGIC
	--==================================================

	local minimized = false
	local oldSize = Main.Size

	Minimize.MouseButton1Click:Connect(function()
		minimized = not minimized

		if minimized then
			oldSize = Main.Size

			Main.Size = UDim2.new(
				0,
				Main.Size.X.Offset,
				0,
				36
			)

			TabFrame.Visible = false
			Content.Visible = false
			Resize.Visible = false
			TitleBottom.Visible = false
		else
			Main.Size = oldSize

			TabFrame.Visible = true
			Content.Visible = true
			Resize.Visible = true
			TitleBottom.Visible = true
		end
	end)

	--==================================================
	-- COMPONENT FUNCTIONS
	--==================================================

	local AddButton
	local AddToggle
	local AddSlider
	local AddTextLabel
	local AddParagraph
	local AddDropdown
	local AddCooldownButton

	--==================================================
	-- BUTTON
	--==================================================

	function AddButton(page, text, callback)
		local Btn = Instance.new("TextButton")

		Btn.Size = UDim2.new(1, 0, 0, 32)
		Btn.BackgroundColor3 = Theme.Button
		Btn.BorderSizePixel = 0
		Btn.Text = text
		Btn.TextColor3 = Theme.Text
		Btn.TextSize = 13
		Btn.Font = Enum.Font.Gotham
		Btn.AutoButtonColor = false
		Btn.Parent = page

		Btn:SetAttribute("ThemeRole", "Button")

		local Corner = Instance.new("UICorner")
		Corner.CornerRadius = UDim.new(0, 6)
		Corner.Parent = Btn

		local Stroke = Instance.new("UIStroke")
		Stroke.Color = Theme.Border
		Stroke.Thickness = 1
		Stroke.Parent = Btn

		Stroke:SetAttribute("ThemeRole", "Border")

		Btn.MouseEnter:Connect(function()
			Btn.BackgroundColor3 = Theme.ButtonHover
		end)

		Btn.MouseLeave:Connect(function()
			Btn.BackgroundColor3 = Theme.Button
		end)

		Btn.MouseButton1Click:Connect(callback or function() end)

		return Btn
	end

	--==================================================
	-- TOGGLE
	--==================================================

	function AddToggle(page, text, default, callback)
		local Frame = Instance.new("Frame")

		Frame.Size = UDim2.new(1, 0, 0, 32)
		Frame.BackgroundTransparency = 1
		Frame.Parent = page

		local Label = Instance.new("TextLabel")

		Label.Size = UDim2.new(1, -55, 1, 0)
		Label.BackgroundTransparency = 1
		Label.Text = text
		Label.TextColor3 = Theme.Text
		Label.TextSize = 13
		Label.Font = Enum.Font.Gotham
		Label.TextXAlignment = Enum.TextXAlignment.Left
		Label.Parent = Frame

		Label:SetAttribute("ThemeRole", "Text")

		local state = default or false

		local Toggle = Instance.new("TextButton")

		Toggle.Size = UDim2.new(0, 44, 0, 22)
		Toggle.Position = UDim2.new(1, -44, 0.5, -11)
		Toggle.BackgroundColor3 = state and Theme.ToggleOn or Theme.ToggleOff
		Toggle.BorderSizePixel = 0
		Toggle.Text = ""
		Toggle.AutoButtonColor = false
		Toggle.Parent = Frame

		Toggle:SetAttribute(
			"ThemeRole",
			state and "ToggleOn" or "ToggleOff"
		)

		local ToggleCorner = Instance.new("UICorner")
		ToggleCorner.CornerRadius = UDim.new(1, 0)
		ToggleCorner.Parent = Toggle

		local Circle = Instance.new("Frame")

		Circle.Size = UDim2.new(0, 16, 0, 16)

		Circle.Position = state
			and UDim2.new(1, -19, 0.5, -8)
			or UDim2.new(0, 3, 0.5, -8)

		Circle.BackgroundColor3 = Color3.fromRGB(240, 240, 240)
		Circle.BorderSizePixel = 0
		Circle.Parent = Toggle

		local CircleCorner = Instance.new("UICorner")
		CircleCorner.CornerRadius = UDim.new(1, 0)
		CircleCorner.Parent = Circle

		Toggle.MouseButton1Click:Connect(function()
			state = not state

			local goalPos = state
				and UDim2.new(1, -19, 0.5, -8)
				or UDim2.new(0, 3, 0.5, -8)

			local goalColor = state
				and Theme.ToggleOn
				or Theme.ToggleOff

			Toggle:SetAttribute(
				"ThemeRole",
				state and "ToggleOn" or "ToggleOff"
			)

			TweenService:Create(
				Circle,
				TweenInfo.new(0.15),
				{
					Position = goalPos
				}
			):Play()

			TweenService:Create(
				Toggle,
				TweenInfo.new(0.15),
				{
					BackgroundColor3 = goalColor
				}
			):Play()

			if callback then
				callback(state)
			end
		end)

		return Toggle
	end

	--==================================================
	-- SLIDER
	--==================================================

	function AddSlider(page, text, min, max, default, callback)
		local Frame = Instance.new("Frame")

		Frame.Size = UDim2.new(1, 0, 0, 46)
		Frame.BackgroundTransparency = 1
		Frame.Parent = page

		local Label = Instance.new("TextLabel")

		Label.Size = UDim2.new(1, 0, 0, 18)
		Label.BackgroundTransparency = 1
		Label.Text = text .. ": " .. tostring(default)
		Label.TextColor3 = Theme.Text
		Label.TextSize = 13
		Label.Font = Enum.Font.Gotham
		Label.TextXAlignment = Enum.TextXAlignment.Left
		Label.Parent = Frame

		Label:SetAttribute("ThemeRole", "Text")

		local Bar = Instance.new("Frame")

		Bar.Size = UDim2.new(1, 0, 0, 8)
		Bar.Position = UDim2.new(0, 0, 0, 28)
		Bar.BackgroundColor3 = Color3.fromRGB(35, 50, 58)
		Bar.BorderSizePixel = 0
		Bar.Parent = Frame

		local BarCorner = Instance.new("UICorner")
		BarCorner.CornerRadius = UDim.new(1, 0)
		BarCorner.Parent = Bar

		local percent = math.clamp(
			(default - min) / (max - min),
			0,
			1
		)

		local Fill = Instance.new("Frame")

		Fill.Size = UDim2.new(percent, 0, 1, 0)
		Fill.BackgroundColor3 = Theme.Accent
		Fill.BorderSizePixel = 0
		Fill.Parent = Bar

		Fill:SetAttribute("ThemeRole", "Accent")

		local FillCorner = Instance.new("UICorner")
		FillCorner.CornerRadius = UDim.new(1, 0)
		FillCorner.Parent = Fill

		local Handle = Instance.new("Frame")

		Handle.Size = UDim2.new(0, 16, 0, 16)
		Handle.Position = UDim2.new(percent, -8, 0.5, -8)
		Handle.BackgroundColor3 = Color3.fromRGB(240, 240, 240)
		Handle.BorderSizePixel = 0
		Handle.ZIndex = 2
		Handle.Parent = Bar

		local HandleCorner = Instance.new("UICorner")
		HandleCorner.CornerRadius = UDim.new(1, 0)
		HandleCorner.Parent = Handle

		local draggingSlider = false

		local function update(input)
			local newPercent = math.clamp(
				(input.Position.X - Bar.AbsolutePosition.X)
					/ Bar.AbsoluteSize.X,
				0,
				1
			)

			local value = math.floor(
				min + (max - min) * newPercent
			)

			Fill.Size = UDim2.new(
				newPercent,
				0,
				1,
				0
			)

			Handle.Position = UDim2.new(
				newPercent,
				-8,
				0.5,
				-8
			)

			Label.Text = text .. ": " .. value

			if callback then
				callback(value)
			end
		end

		Handle.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 then
				draggingSlider = true
			end
		end)

		Handle.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 then
				draggingSlider = false
			end
		end)

		Bar.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 then
				draggingSlider = true
				update(input)
			end
		end)

		UIS.InputChanged:Connect(function(input)
			if draggingSlider
				and input.UserInputType == Enum.UserInputType.MouseMovement then

				update(input)
			end
		end)

		UIS.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 then
				draggingSlider = false
			end
		end)

		return Fill
	end

