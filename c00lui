--[[ 
    c00lUI
]]

local c00lui = {}

function c00lui:Window(config)
    config = config or {}
    local win = {}

    win.title  = config.Title or "c00lgui"
    win.accent = config.AccentColor or Color3.fromRGB(255,0,0)
    win.bg     = Color3.fromRGB(0,0,0)
    win.text   = Color3.fromRGB(255,255,255)
    win.pages  = {}
    win.current = 1

    ------------------------------------------------
    -- REMOVE GUIS ANTIGAS
    ------------------------------------------------

    for _,v in ipairs(game.CoreGui:GetChildren()) do
        if v:IsA("ScreenGui") and v.Name == "c00lUI" then
            v:Destroy()
        end
    end

    ------------------------------------------------
    -- BASE
    ------------------------------------------------

    local sg = Instance.new("ScreenGui")
    sg.Name = "c00lUI"
    sg.Parent = game.CoreGui
    sg.ResetOnSpawn = false

    local mf = Instance.new("Frame", sg)
    mf.Size = UDim2.new(0,300,0,400)
    mf.Position = UDim2.new(0,10,0.3,0)
    mf.BackgroundColor3 = win.bg
    mf.BorderColor3 = win.accent
    mf.BorderSizePixel = 3

    win._frame = mf
    
    local title = Instance.new("TextLabel", mf)
    title.Size = UDim2.new(1,0,0,30)
    title.Text = win.title
    title.BackgroundColor3 = win.bg
    title.BorderSizePixel = 0
    title.TextColor3 = win.text
    title.TextSize = 15
    title.TextWrapped = true

    ------------------------------------------------
    -- NAV
    ------------------------------------------------

    local nav = Instance.new("Frame", mf)
    nav.Size = UDim2.new(1,0,0,40)
    nav.Position = UDim2.new(0,0,0,30)
    nav.BackgroundColor3 = win.bg
    nav.BorderSizePixel = 0

    local left = Instance.new("TextButton", nav)
    left.Size = UDim2.new(0.5,0,1,0)
    left.Text = "<"
    left.TextScaled = true
    left.BackgroundColor3 = win.bg
    left.BorderColor3 = win.accent
    left.BorderSizePixel = 3
    left.TextColor3 = win.text

    local right = Instance.new("TextButton", nav)
    right.Size = UDim2.new(0.5,0,1,0)
    right.Position = UDim2.new(0.5,0,0,0)
    right.Text = ">"
    right.TextScaled = true
    right.BackgroundColor3 = win.bg
    right.BorderColor3 = win.accent
    right.BorderSizePixel = 3
    right.TextColor3 = win.text

    local container = Instance.new("Frame", mf)
    container.Size = UDim2.new(1,0,1,-70)
    container.Position = UDim2.new(0,0,0,70)
    container.BackgroundTransparency = 1

    ------------------------------------------------
    -- TOGGLE
    ------------------------------------------------

    local toggleBtn = Instance.new("TextButton", sg)
    toggleBtn.Size = UDim2.new(0,300,0,20)
    toggleBtn.Position = UDim2.new(0,10,0.3,400)
    toggleBtn.Text = "Close"
    toggleBtn.BackgroundColor3 = win.bg
    toggleBtn.BorderColor3 = win.accent
    toggleBtn.BorderSizePixel = 3
    toggleBtn.TextColor3 = win.text
    toggleBtn.TextSize = 9
    toggleBtn.TextWrapped = true

    toggleBtn.MouseButton1Click:Connect(function()
        local st = not mf.Visible
        mf.Visible = st

        for i,v in ipairs(win.pages) do
            v.frame.Visible = st and (i == win.current)
        end

        toggleBtn.Text = st and "Close" or "Open"
    end)

    ------------------------------------------------
    -- ADD PAGE
    ------------------------------------------------

    function win:AddPage()
        local pageframe = Instance.new("Frame", container)
        pageframe.Size = UDim2.new(1,0,1,0)
        pageframe.BackgroundTransparency = 1
        pageframe.Visible = (#win.pages == 0)

        local page = {frame = pageframe, sectionCount = 0}

        function page:AddSection(name)
            page.sectionCount += 1
            local leftSide = (page.sectionCount % 2 == 1)

            local sec = Instance.new("Frame", pageframe)
            sec.Size = UDim2.new(0.5,0,1,0)
            sec.Position = leftSide and UDim2.new(0,0,0,0) or UDim2.new(0.5,0,0,0)
            sec.BackgroundColor3 = win.bg
            sec.BorderColor3 = win.accent
            sec.BorderSizePixel = 3

            local tit = Instance.new("TextLabel", sec)
            tit.Size = UDim2.new(1,0,0,25)
            tit.Text = name
            tit.BackgroundColor3 = win.bg
            tit.BorderSizePixel = 0
            tit.TextColor3 = win.text
            tit.TextSize = 12
            tit.TextWrapped = true

            local content = Instance.new("Frame", sec)
            content.Size = UDim2.new(1,0,1,-25)
            content.Position = UDim2.new(0,0,0,25)
            content.BackgroundTransparency = 1

            local cursorY, col = 0, 0
            local padding, height = 4, 30

            local function colWidth()
                return (content.AbsoluteSize.X - padding) / 2
            end

            local function styleText(obj)
                obj.TextWrapped = true
                obj.TextXAlignment = Enum.TextXAlignment.Center
                obj.TextYAlignment = Enum.TextYAlignment.Center

                local pad = Instance.new("UIPadding", obj)
                pad.PaddingLeft = UDim.new(0,6)
                pad.PaddingRight = UDim.new(0,6)
            end

            local section = {}

            function section:AddButton(text, callback)
                local w = colWidth()
                local btn = Instance.new("TextButton", content)
                btn.Size = UDim2.new(0,w,0,height)
                btn.Position = UDim2.new(0,col*(w+padding),0,cursorY)
                btn.Text = text
                btn.BackgroundColor3 = win.bg
                btn.BorderColor3 = win.accent
                btn.BorderSizePixel = 3
                btn.TextColor3 = win.text
                btn.TextSize = 9
                styleText(btn)

                if callback then
                    btn.MouseButton1Click:Connect(callback)
                end

                col += 1
                if col >= 2 then col = 0 cursorY += height + padding end
                return btn
            end

            function section:AddLabel(text)
                col = 0
                local lbl = Instance.new("TextLabel", content)
                lbl.Size = UDim2.new(1,0,0,height)
                lbl.Position = UDim2.new(0,0,0,cursorY)
                lbl.Text = text
                lbl.BackgroundColor3 = win.bg
                lbl.BorderColor3 = win.accent
                lbl.BorderSizePixel = 3
                lbl.TextColor3 = win.text
                lbl.TextSize = 9
                styleText(lbl)
                section._lastLabel = lbl

                cursorY += height + padding
            end

            function section:AddSmallTextbox(placeholder, callback)
                local w = colWidth()
                local box = Instance.new("TextBox", content)
                box.Size = UDim2.new(0,w,0,height)
                box.Position = UDim2.new(0,col*(w+padding),0,cursorY)
                box.PlaceholderText = placeholder or "Digite..."
                box.Text = ""
                box.ClearTextOnFocus = false
                box.BackgroundColor3 = win.bg
                box.BorderColor3 = win.accent
                box.BorderSizePixel = 3
                box.TextColor3 = win.text
                box.TextSize = 10
                styleText(box)

                box.FocusLost:Connect(function(e)
                    if callback then callback(box.Text, e) end
                end)

                col += 1
                if col >= 2 then col = 0 cursorY += height + padding end
            end

            function section:AddBigTextbox(placeholder, callback)
                col = 0
                local box = Instance.new("TextBox", content)
                box.Size = UDim2.new(1,0,0,height)
                box.Position = UDim2.new(0,0,0,cursorY)
                box.PlaceholderText = placeholder or "Digite aqui..."
                box.Text = ""
                box.ClearTextOnFocus = false
                box.BackgroundColor3 = win.bg
                box.BorderColor3 = win.accent
                box.BorderSizePixel = 3
                box.TextColor3 = win.text
                box.TextSize = 10
                styleText(box)

                box.FocusLost:Connect(function(e)
                    if callback then callback(box.Text, e) end
                end)

                cursorY += height + padding
            end

            return section
        end

        table.insert(win.pages, page)
        return page
    end

    left.MouseButton1Click:Connect(function()
        if win.current > 1 then
            win.pages[win.current].frame.Visible = false
            win.current -= 1
            win.pages[win.current].frame.Visible = true
        end
    end)

    right.MouseButton1Click:Connect(function()
        if win.current < #win.pages then
            win.pages[win.current].frame.Visible = false
            win.current += 1
            win.pages[win.current].frame.Visible = true
        end
    end)

    return win
end

function c00lui:SideTab(win, config)
    config = config or {}
    local side = {}

    side.title  = config.Title or "Side"
    side.bg     = win.bg
    side.accent = win.accent
    side.text   = win.text
    side.open   = false

    local TweenService = game:GetService("TweenService")

    local mf = win._frame
    if not mf then return warn("window inválida") end

    local sg = mf.Parent
    local basePos = mf.Position

    ------------------------------------------------
    -- SIDE FRAME (ATRÁS)
    ------------------------------------------------

    local sideFrame = Instance.new("Frame", sg)
    sideFrame.Size = UDim2.new(0,300,0,400)
    sideFrame.Position = basePos -- mesma posição da window
    sideFrame.BackgroundColor3 = side.bg
    sideFrame.BorderColor3 = side.accent
    sideFrame.BorderSizePixel = 3
    sideFrame.ZIndex = 0 -- 🔥 ATRÁS

    ------------------------------------------------
    -- BOTÃO (UM POUCO MAIS GROSSO)
    ------------------------------------------------

    local barWidth = 16 -- 👈 ajustado (antes tava fino demais)

    local bar = Instance.new("TextButton", sideFrame)
    bar.Size = UDim2.new(0,barWidth,1,0)
    bar.Position = UDim2.new(1,0,0,0) -- fica pra fora
    bar.Text = ">"
    bar.BackgroundColor3 = side.bg
    bar.BorderColor3 = side.accent
    bar.BorderSizePixel = 3
    bar.TextColor3 = side.text
    bar.TextScaled = true
    bar.ZIndex = 2

    ------------------------------------------------
    -- TITLE
    ------------------------------------------------

    local title = Instance.new("TextLabel", sideFrame)
    title.Size = UDim2.new(1,-barWidth,0,30)
    title.Text = side.title
    title.BackgroundColor3 = side.bg
    title.BorderSizePixel = 0
    title.TextColor3 = side.text

    ------------------------------------------------
    -- CONTAINER
    ------------------------------------------------

    local container = Instance.new("Frame", sideFrame)
    container.Size = UDim2.new(1,-barWidth,1,-30)
    container.Position = UDim2.new(0,0,0,30)
    container.BackgroundTransparency = 1

    ------------------------------------------------
    -- COMEÇA FECHADA DE VERDADE
    ------------------------------------------------

    sideFrame.Position = basePos + UDim2.new(0,0,0,0) -- atrás da window

    ------------------------------------------------
    -- TWEEN
    ------------------------------------------------

    local function toggleSide()
        side.open = not side.open

        local goal = side.open and basePos + UDim2.new(0,300,0,0)
                              or basePos

        TweenService:Create(sideFrame, TweenInfo.new(0.25), {
            Position = goal
        }):Play()

        bar.Text = side.open and "<" or ">"
    end

    bar.MouseButton1Click:Connect(toggleSide)

    ------------------------------------------------
    -- FECHAR COM A MAIN
    ------------------------------------------------

    mf:GetPropertyChangedSignal("Visible"):Connect(function()
        sideFrame.Visible = mf.Visible
    end)

    ------------------------------------------------
    -- PAGE
    ------------------------------------------------

    function side:AddPage()
        local y = 0

        return {
            SAddButton = function(_, text, callback)
                local btn = Instance.new("TextButton", container)
                btn.Size = UDim2.new(1,0,0,30)
                btn.Position = UDim2.new(0,0,0,y)
                btn.Text = text
                btn.BackgroundColor3 = side.bg
                btn.BorderColor3 = side.accent
                btn.BorderSizePixel = 3
                btn.TextColor3 = side.text

                if callback then
                    btn.MouseButton1Click:Connect(callback)
                end

                y += 34
            end
        }
    end

    return side
end

----------------------------------------------------------------
-- COMPATIBILIDADE COM A API IceHub (UI2/ui2 do repositório)
-- Mantém a aparência da c00lui, adaptando os nomes/argumentos públicos.
----------------------------------------------------------------

local function _c00luiCompatSection(section, win)
    -- Recursos desativados por escolha: chamadas são aceitas sem criar UI.
    function section:NewNotify(...) end

    -- AddParagraph pode aparecer em scripts antigos; ignorar sem interromper execução.
    function section:AddParagraph(...) end
    function section:NewParagraph(...) end

    -- API original: NewSmall(buttonText, callback)
    function section:NewSmall(buttonText, callback)
        return section:AddButton(buttonText, callback)
    end

    -- API original: NewButton(labelText, helpMessage, action)
    function section:NewButton(labelText, helpMessage, action)
        if type(helpMessage) == "function" and action == nil then
            action = helpMessage
        end
        return section:AddButton(labelText, action)
    end

    -- API original: NewToggle(label, helpMessage, callback)
    function section:NewToggle(toggleLabel, helpMessage, callback)
        if type(helpMessage) == "function" and callback == nil then
            callback = helpMessage
        end
        local enabled = false
        local btn
        btn = section:AddButton("[ ] " .. tostring(toggleLabel), function()
            enabled = not enabled
            if btn then btn.Text = (enabled and "[X] " or "[ ] ") .. tostring(toggleLabel) end
            if callback then callback(enabled) end
        end)
        local obj = {}
        function obj:Enable()
            if not enabled then
                enabled = true
                if btn then btn.Text = "[X] " .. tostring(toggleLabel) end
                if callback then callback(true) end
            end
        end
        function obj:Disable()
            if enabled then
                enabled = false
                if btn then btn.Text = "[ ] " .. tostring(toggleLabel) end
                if callback then callback(false) end
            end
        end
        function obj:GetState() return enabled end
        return obj
    end

    -- API original: NewLabel(labelText) -> object with UpdateLabel(newText)
    function section:NewLabel(labelText)
        section:AddLabel(labelText)
        local obj = {}
        function obj:UpdateLabel(newText)
            -- Existing AddLabel doesn't expose its TextLabel, so add a replacement
            -- label reference when available through the last created element.
            if section._lastLabel and section._lastLabel.Parent then
                section._lastLabel.Text = tostring(newText)
            end
        end
        return obj
    end

    -- API original: NewTextBox(boxLabel, placeholderText, boxName)
    function section:NewTextBox(boxLabel, placeholderText, boxName)
        local callback = nil
        local placeholder = placeholderText or boxLabel or "Digite..."
        local box = section:AddBigTextbox(placeholder, function(value)
            if callback then callback(value) end
        end)
        return {
            SetCallback = function(_, fn) callback = fn end,
            SetPlaceholder = function(_, value)
                if box then box.PlaceholderText = tostring(value) end
            end
        }
    end

    -- API original: NewSlider(label, min, max, callback)
    -- Text input is used as a reliable fallback in this lightweight adapter.
    function section:NewSlider(sliderLabel, minValue, maxValue, callback)
        minValue = tonumber(minValue) or 0
        maxValue = tonumber(maxValue) or 100
        local box = section:AddSmallTextbox(tostring(sliderLabel) .. " (" .. minValue .. "-" .. maxValue .. ")", function(value)
            local number = tonumber(value)
            if number then
                number = math.clamp(number, minValue, maxValue)
                if callback then callback(number) end
            end
        end)
        return box
    end

    -- Dropdowns desativados: mantém apenas uma interface de compatibilidade.
    -- Não seleciona itens nem chama callbacks implicitamente.
    local function ignoredDropdown()
        local obj = {}
        function obj:Refresh(...) end
        function obj:SetValue(...) end
        function obj:Set(...) end
        function obj:GetValue() return nil end
        function obj:Get() return nil end
        function obj:Destroy() end
        return obj
    end

    function section:NewDropdown(...) return ignoredDropdown() end
    function section:NewSearchDropdown(...) return ignoredDropdown() end

    -- Variantes com cooldown presentes na API original.
    function section:NewButtonCooldown(labelText, helpMessage, cooldownSeconds, action)
        local cooling = false
        return section:AddButton(labelText, function()
            if cooling then return end
            cooling = true
            if action then task.spawn(action) end
            task.delay(tonumber(cooldownSeconds) or 0, function()
                cooling = false
            end)
        end)
    end

    function section:NewToggleCooldown(toggleLabel, helpMessage, cooldownSeconds, callback)
        local enabled = false
        local cooling = false
        local btn
        btn = section:AddButton("[ ] " .. tostring(toggleLabel), function()
            if cooling then return end
            cooling = true
            enabled = not enabled
            if btn then btn.Text = (enabled and "[X] " or "[ ] ") .. tostring(toggleLabel) end
            if callback then callback(enabled) end
            task.delay(tonumber(cooldownSeconds) or 0, function()
                cooling = false
            end)
        end)
        return {
            Enable = function()
                if not enabled then
                    enabled = true
                    if btn then btn.Text = "[X] " .. tostring(toggleLabel) end
                    if callback then callback(true) end
                end
            end,
            Disable = function()
                if enabled then
                    enabled = false
                    if btn then btn.Text = "[ ] " .. tostring(toggleLabel) end
                    if callback then callback(false) end
                end
            end,
            GetState = function() return enabled end
        }
    end

    -- Extras that occur in some scripts built against IceHub.
    function section:WaitingFrame(message)
        return section:AddLabel(message or "Carregando...")
    end
    function section:CloseWaitingFrame() end

    return section
end

-- API de entrada da UI2 original: IceHub.CreateMain(hubName, gameName, subtitle)
function c00lui.CreateMain(hubName, gameName, subtitle)
    local win = c00lui:Window({
        Title = tostring(hubName or "c00lgui"),
        AccentColor = Color3.fromRGB(0, 255, 255)
    })
    win.GameName = gameName or ""
    win.Subtitle = subtitle or ""

    function win:NewTab(tabTitle, tabName)
        local page = self:AddPage()
        page.Name = tabName or tostring(tabTitle or "Tab")
        page.Title = tabTitle or page.Name

        function page:NewSection(sectionName)
            local section = self:AddSection(sectionName or tabTitle or "Section")
            return _c00luiCompatSection(section, win)
        end

        -- Some scripts call controls directly on the tab without NewSection.
        local directSection = nil
        local function getDirectSection()
            if not directSection then
                directSection = _c00luiCompatSection(page:AddSection(tabTitle or "Section"), win)
            end
            return directSection
        end
        for _, methodName in ipairs({
            "NewNotify", "NewSmall", "NewButton", "NewButtonCooldown",
            "NewToggle", "NewToggleCooldown", "NewLabel", "NewTextBox",
            "NewSlider", "NewDropdown", "NewSearchDropdown", "AddParagraph", "NewParagraph",
            "WaitingFrame", "CloseWaitingFrame"
        }) do
            page[methodName] = function(_, ...)
                return getDirectSection()[methodName](getDirectSection(), ...)
            end
        end
        return page
    end

    function win:Notification(...) end

    function win:ChangePresetColor(color)
        if typeof(color) == "Color3" then
            self.accent = color
            if self._frame then self._frame.BorderColor3 = color end
        end
    end

    return win
end

-- Alias adicional para scripts que usam a capitalização do nome antigo.
c00lui.CreateMain = c00lui.CreateMain

return c00lui
