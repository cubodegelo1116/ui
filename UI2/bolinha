local FloatingMinimizer = {}
local UserInputService = game:GetService("UserInputService")

local DEFAULT = {
    Size = UDim2.new(0, 45, 0, 45),
    Position = UDim2.new(0, 20, 0.5, -22),
    BackgroundColor = Color3.fromRGB(20, 20, 20),
    BackgroundTransparency = 0.1,
    StrokeColor = Color3.fromRGB(49, 49, 49),
    StrokeTransparency = 0.2,
    Text = "IH",
    TextColor = Color3.fromRGB(0, 255, 255),
    TextSize = 16,
    Font = Enum.Font.GothamBold,
    Image = "",
    ImageColor = Color3.fromRGB(255, 255, 255),
    UseImage = false,
    Visible = true,
    SnapToEdges = false,
    SnapMargin = 10,
    DragThreshold = 6,
}

function FloatingMinimizer.Create(userConfig)
    local cfg = {}
    for k, v in pairs(DEFAULT) do cfg[k] = v end
    if userConfig then
        for k, v in pairs(userConfig) do cfg[k] = v end
    end

    local screenGui
    for _ = 1, 50 do
        screenGui = game.CoreGui:FindFirstChild("IceHub")
        if screenGui then break end
        task.wait(0.1)
    end
    if not screenGui then
        warn("[FloatingMinimizer] IceHub não encontrada.")
        return nil
    end

    local mainFrameShadow = screenGui:FindFirstChild("MainFrameShadow")
    if not mainFrameShadow then
        warn("[FloatingMinimizer] MainFrameShadow não encontrada.")
        return nil
    end

    local old = screenGui:FindFirstChild("FloatingMinimizer")
    if old then old:Destroy() end

    local floating = Instance.new("TextButton")
    floating.Name = "FloatingMinimizer"
    floating.Parent = screenGui
    floating.BackgroundColor3 = cfg.BackgroundColor
    floating.BackgroundTransparency = cfg.BackgroundTransparency
    floating.BorderSizePixel = 0
    floating.Position = cfg.Position
    floating.Size = cfg.Size
    floating.AutoButtonColor = false
    floating.Text = ""
    floating.ZIndex = 100
    floating.Active = true
    floating.Visible = cfg.Visible
    floating.ClipsDescendants = false

    local shadow = Instance.new("ImageLabel")
    shadow.Name = "Shadow"
    shadow.Parent = floating
    shadow.AnchorPoint = Vector2.new(0.5, 0.5)
    shadow.BackgroundTransparency = 1
    shadow.BorderSizePixel = 0
    shadow.Position = UDim2.new(0.5, 0, 0.5, 0)
    shadow.Size = UDim2.new(1, 16, 1, 16)
    shadow.ZIndex = -1
    shadow.Image = "rbxassetid://6014261993"
    shadow.ImageColor3 = Color3.fromRGB(0, 0, 0)
    shadow.ImageTransparency = 0.5
    shadow.ScaleType = Enum.ScaleType.Slice
    shadow.SliceCenter = Rect.new(49, 49, 450, 450)

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(1, 0)
    corner.Parent = floating

    local stroke = Instance.new("UIStroke")
    stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    stroke.Color = cfg.StrokeColor
    stroke.Thickness = 1
    stroke.Transparency = cfg.StrokeTransparency
    stroke.Parent = floating

    local icon, label
    if cfg.UseImage and cfg.Image ~= "" then
        icon = Instance.new("ImageLabel")
        icon.Name = "Icon"
        icon.Parent = floating
        icon.AnchorPoint = Vector2.new(0.5, 0.5)
        icon.BackgroundTransparency = 1
        icon.Position = UDim2.new(0.5, 0, 0.5, 0)
        icon.Size = UDim2.new(0.65, 0, 0.65, 0)
        icon.Image = cfg.Image
        icon.ImageColor3 = cfg.ImageColor
        icon.ZIndex = 2
    else
        label = Instance.new("TextLabel")
        label.Name = "Label"
        label.Parent = floating
        label.BackgroundTransparency = 1
        label.Size = UDim2.new(1, 0, 1, 0)
        label.Font = cfg.Font
        label.Text = cfg.Text
        label.TextColor3 = cfg.TextColor
        label.TextSize = cfg.TextSize
        label.TextXAlignment = Enum.TextXAlignment.Center
        label.TextYAlignment = Enum.TextYAlignment.Center
        label.ZIndex = 2
    end

    local dragging = false
    local dragInputType = nil
    local dragStart, startPos
    local moved = false
    local downTime = 0
    local activeInput = nil

    local function endDrag()
        if not dragging then return end
        dragging = false
        activeInput = nil

        if cfg.SnapToEdges then
            local vp = workspace.CurrentCamera.ViewportSize
            local absPos = floating.AbsolutePosition
            local absSize = floating.AbsoluteSize
            local centerX = absPos.X + absSize.X / 2
            local x

            if centerX < vp.X / 2 then
                x = cfg.SnapMargin
            else
                x = vp.X - absSize.X - cfg.SnapMargin
            end

            local y = math.clamp(absPos.Y, cfg.SnapMargin, vp.Y - absSize.Y - cfg.SnapMargin)

            local tween = game:GetService("TweenService"):Create(
                floating, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
                { Position = UDim2.new(0, x, 0, y) }
            )
            tween:Play()
        end

        if not moved and (tick() - downTime) < 0.5 then
            mainFrameShadow.Visible = not mainFrameShadow.Visible
        end
    end

    floating.InputBegan:Connect(function(input)
        if input.UserInputType ~= Enum.UserInputType.MouseButton1
        and input.UserInputType ~= Enum.UserInputType.Touch then
            return
        end

        if dragging then return end

        dragging = true
        moved = false
        downTime = tick()
        dragInputType = input.UserInputType
        activeInput = input
        dragStart = input.Position
        startPos = floating.Position

        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End
            or input.UserInputState == Enum.UserInputState.Cancel then
                endDrag()
            end
        end)
    end)

    UserInputService.InputChanged:Connect(function(input)
        if not dragging then return end
        if input.UserInputType ~= dragInputType then return end
        if input.UserInputType == Enum.UserInputType.Touch and activeInput and input ~= activeInput then
            return
        end

        local delta = input.Position - dragStart
        if math.abs(delta.X) > cfg.DragThreshold or math.abs(delta.Y) > cfg.DragThreshold then
            moved = true
        end

        floating.Position = UDim2.new(
            startPos.X.Scale, startPos.X.Offset + delta.X,
            startPos.Y.Scale, startPos.Y.Offset + delta.Y
        )
    end)

    UserInputService.InputEnded:Connect(function(input)
        if dragging and input == activeInput then
            endDrag()
        end
    end)

    local api = {}

    function api.Hide()      mainFrameShadow.Visible = false end
    function api.Show()      mainFrameShadow.Visible = true  end
    function api.Toggle()    mainFrameShadow.Visible = not mainFrameShadow.Visible end
    function api.IsOpen()    return mainFrameShadow.Visible end

    function api.SetText(text)
        if label then label.Text = text end
    end

    function api.SetTextColor(color)
        if label then label.TextColor3 = color end
    end

    function api.SetImage(imageId)
        if icon then
            icon.Image = imageId
        elseif label then
            label:Destroy()
            label = nil
            icon = Instance.new("ImageLabel")
            icon.Name = "Icon"
            icon.Parent = floating
            icon.AnchorPoint = Vector2.new(0.5, 0.5)
            icon.BackgroundTransparency = 1
            icon.Position = UDim2.new(0.5, 0, 0.5, 0)
            icon.Size = UDim2.new(0.65, 0, 0.65, 0)
            icon.Image = imageId
            icon.ZIndex = 2
        end
    end

    function api.SetPosition(pos)
        floating.Position = pos
    end

    function api.SetVisible(v)
        floating.Visible = v
    end

    function api.Destroy()
        floating:Destroy()
    end

    api.Instance = floating

    return api
end

return FloatingMinimizer
