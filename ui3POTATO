		PanelStroke:SetAttribute("ThemeRole", "Border")

		local SearchBox = Instance.new("TextBox")
		SearchBox.Name = "SearchBox"
		SearchBox.Position = UDim2.new(0, 5, 0, 5)
		SearchBox.Size = UDim2.new(1, -10, 0, 28)
		SearchBox.BackgroundColor3 = Theme.Button
		SearchBox.BorderSizePixel = 0
		SearchBox.TextColor3 = Theme.Text
		SearchBox.PlaceholderColor3 = Theme.TextDark
		SearchBox.PlaceholderText = searchPlaceholder
		SearchBox.Text = ""
		SearchBox.ClearTextOnFocus = false
		SearchBox.Font = Enum.Font.Gotham
		SearchBox.TextSize = 12
		SearchBox.TextXAlignment = Enum.TextXAlignment.Left
		SearchBox.ZIndex = 81
		SearchBox.Parent = Panel
		SearchBox:SetAttribute("ThemeRole", "Button")
		SearchBox.TextStrokeTransparency = 1
		local SearchPadding = Instance.new("UIPadding")
		SearchPadding.PaddingLeft = UDim.new(0, 8)
		SearchPadding.Parent = SearchBox
		local SearchCorner = Instance.new("UICorner")
		SearchCorner.CornerRadius = UDim.new(0, 5)
		SearchCorner.Parent = SearchBox
		local SearchStroke = Instance.new("UIStroke")
		SearchStroke.Color = Theme.Border
		SearchStroke.Thickness = 1
		SearchStroke.Parent = SearchBox
		SearchStroke:SetAttribute("ThemeRole", "Border")

		local List = Instance.new("ScrollingFrame")
		List.Name = "Options"
		List.Position = UDim2.new(0, 5, 0, 38)
		List.Size = UDim2.new(1, -10, 1, -43)
		List.BackgroundTransparency = 1
		List.BorderSizePixel = 0
		List.ScrollBarThickness = 3
		List.ScrollBarImageColor3 = Theme.Border
		List.ScrollingDirection = Enum.ScrollingDirection.Y
		List.CanvasSize = UDim2.new(0, 0, 0, 0)
		List.AutomaticCanvasSize = Enum.AutomaticSize.Y
		List.ZIndex = 81
		List.Parent = Panel
		local ListLayout = Instance.new("UIListLayout")
		ListLayout.SortOrder = Enum.SortOrder.LayoutOrder
		ListLayout.Padding = UDim.new(0, 2)
		ListLayout.Parent = List
		local ListPadding = Instance.new("UIPadding")
		ListPadding.PaddingTop = UDim.new(0, 2)
		ListPadding.PaddingBottom = UDim.new(0, 2)
		ListPadding.Parent = List

		local function UpdateButtonText()
			Button.Text = "  " .. title .. ": " .. (selectedValue and tostring(selectedValue) or "Nenhum")
		end

		local function UpdateFilter()
			local query = string.lower(FixMojibake(SearchBox.Text or ""))
			for value, optionButton in pairs(optionButtons) do
				optionButton.Visible = query == "" or string.find(string.lower(value), query, 1, true) ~= nil
			end
			task.defer(function()
				if List and List.Parent then
					List.CanvasPosition = Vector2.new(0, 0)
					List.CanvasSize = UDim2.new(0, 0, 0, ListLayout.AbsoluteContentSize.Y + 5)
				end
			end)
		end

		local function RebuildOptions()
			for _, child in ipairs(List:GetChildren()) do
				if child:IsA("TextButton") then child:Destroy() end
			end
			table.clear(optionButtons)
			for index, value in ipairs(currentOptions) do
				local Option = Instance.new("TextButton")
				Option.Name = "Option"
				Option.LayoutOrder = index
				Option.Size = UDim2.new(1, -2, 0, 27)
				Option.BackgroundColor3 = Theme.Button
				Option.BorderSizePixel = 0
				Option.Text = "  " .. value
				Option.TextColor3 = Theme.Text
				Option.TextSize = 12
				Option.Font = Enum.Font.Gotham
				Option.TextXAlignment = Enum.TextXAlignment.Left
				Option.AutoButtonColor = false
				Option.ZIndex = 82
				Option.TextStrokeTransparency = 1
				Option.Parent = List
				Option:SetAttribute("ThemeRole", "Button")
				local OptionCorner = Instance.new("UICorner")
				OptionCorner.CornerRadius = UDim.new(0, 5)
				OptionCorner.Parent = Option
				optionButtons[value] = Option
				Option.MouseButton1Click:Connect(function()
					selectedValue = value
					UpdateButtonText()
					Panel.Visible = false
					isOpen = false
					Row.Size = UDim2.new(1, -24, 0, 32)
					if callback then
						local ok, err = pcall(callback, value)
						if not ok then warn("[PDDEV] NewSearchDropdown callback error: " .. tostring(err)) end
					end
				end)
			end
			UpdateFilter()
		end

		local function UpdatePanelPosition()
			if not (Button and Button.Parent and Panel and Panel.Parent) then return end
			Panel.Position = UDim2.new(0, 0, 0, 35)
			Panel.Size = UDim2.new(1, 0, 0, 184)
			Row.Size = UDim2.new(1, -24, 0, isOpen and (32 + 3 + 184) or 32)
		end

		Button.MouseButton1Click:Connect(function()
			isOpen = not isOpen
			UpdatePanelPosition()
			if isOpen then
				Panel.Visible = true
				UpdateFilter()
			else
				Panel.Visible = false
			end
		end)
		SearchBox:GetPropertyChangedSignal("Text"):Connect(UpdateFilter)
		ConnectGlobal(UIS.InputBegan, function(input)
			if not isOpen or input.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
			local point = input.Position
			local bp, bs = Button.AbsolutePosition, Button.AbsoluteSize
			local pp, ps = Panel.AbsolutePosition, Panel.AbsoluteSize
			local overButton = point.X >= bp.X and point.X <= bp.X + bs.X and point.Y >= bp.Y and point.Y <= bp.Y + bs.Y
			local overPanel = point.X >= pp.X and point.X <= pp.X + ps.X and point.Y >= pp.Y and point.Y <= pp.Y + ps.Y
			if not overButton and not overPanel then
				isOpen = false
				Panel.Visible = false
				Row.Size = UDim2.new(1, -24, 0, 32)
			end
		end)

		local DropdownAPI = { Instance = Row, Button = Button, SearchBox = SearchBox, Panel = Panel }
		function DropdownAPI.SetOptions(newOptions)
			if typeof(newOptions) ~= "table" then return false end
			currentOptions = NormalizeOptions(newOptions)
			if not table.find(currentOptions, selectedValue) then selectedValue = currentOptions[1] end
			UpdateButtonText()
			RebuildOptions()
			UpdatePanelPosition()
			return true
		end
		function DropdownAPI.Refresh(a, b)
			local newOptions = (a == DropdownAPI) and b or a
			return DropdownAPI.SetOptions(newOptions or {})
		end
		function DropdownAPI.SetValue(value)
			value = tostring(value)
			if not table.find(currentOptions, value) then return false end
			selectedValue = value
			UpdateButtonText()
			if callback then
				local ok, err = pcall(callback, value)
				if not ok then warn("[PDDEV] NewSearchDropdown callback error: " .. tostring(err)) end
			end
			return true
		end
		function DropdownAPI.GetValue() return selectedValue end
		function DropdownAPI.GetOptions() return CopyTable(currentOptions) end
		UpdateButtonText()
		RebuildOptions()
		return DropdownAPI
	end

	local function CompatNewSearchDropdown(owner, a1, a2, a3, a4, a5, a6)
		local dropdownLabel, helpText, placeholder, items, callback
		if a1 == owner then
			dropdownLabel, helpText, placeholder, items, callback = a2, a3, a4, a5, a6
		else
			dropdownLabel, helpText, placeholder, items, callback = a1, a2, a3, a4, a5
		end
		-- Also tolerate a shorter form: NewSearchDropdown(label, placeholder, items, callback).
		if typeof(placeholder) == "table" then
			callback = typeof(items) == "function" and items or callback
			items = placeholder
			placeholder = helpText
		end
		local page = owner and owner.Page
		if not page and owner then page = owner._compatPage end
		return CreateCompatSearchDropdown(page, dropdownLabel, placeholder, items, callback)
	end

	local compatThemeName = "Default"

	function WindowAPI.NewTab(a, b, c)
		-- UI2-compatible call signature: NewTab(title, icon).
		-- Supports both Main:NewTab("Protection", "shield") and
		-- Main.NewTab("Protection", "shield").
		local tabTitle, tabIcon
		if a == WindowAPI then
			tabTitle, tabIcon = b, c
		else
			tabTitle, tabIcon = a, b
		end
		tabTitle = ValidateString(tabTitle, true) or "Tab"
		local tab = CreateTab(tabTitle, tabIcon)

		function tab.NewSearchDropdown(a1, a2, a3, a4, a5, a6)
			return CompatNewSearchDropdown(tab, a1, a2, a3, a4, a5, a6)
		end

		-- UI2-compatible focus textbox. Installed on both the tab and its sections,
		-- because older GUI scripts use both call styles.
		local function CompatNewFocusTextBox(owner, a1, a2, a3, a4, a5)
			local label, placeholder, boxName, callback = UnpackCompatArgs(owner, a1, a2, a3, a4, a5)
			if typeof(callback) ~= "function" and typeof(boxName) == "function" then
				callback = boxName
				boxName = nil
			end
			if typeof(placeholder) == "function" then
				callback, placeholder = placeholder, label
				label = ""
			end
			if label and tostring(label) ~= "" then
				tab.AddTextLabel(tostring(label))
			end
			local boxAPI
			local function OnFocusLost(value)
				if typeof(callback) == "function" then
					task.spawn(function()
						local ok, err = pcall(callback, value)
						if not ok then warn("[PDDEV] NewFocusTextBox callback error: " .. tostring(err)) end
					end)
				end
				task.delay(0.1, function()
					if boxAPI and typeof(boxAPI.Clear) == "function" then
						boxAPI.Clear()
					end
				end)
			end
			boxAPI = tab.AddTextBox(placeholder or "", OnFocusLost)
			return boxAPI
		end

		function tab.NewFocusTextBox(a1, a2, a3, a4, a5)
			return CompatNewFocusTextBox(tab, a1, a2, a3, a4, a5)
		end

		function tab.NewSection()
			local section = { _compatPage = tab.Page }

			function section.NewSearchDropdown(a1, a2, a3, a4, a5, a6)
				return CompatNewSearchDropdown(section, a1, a2, a3, a4, a5, a6)
			end

			function section.NewFocusTextBox(a1, a2, a3, a4, a5)
				return CompatNewFocusTextBox(section, a1, a2, a3, a4, a5)
			end

			function section.NewNotify(a1, a2, a3)
				local message, duration = UnpackCompatArgs(section, a1, a2, a3)
				return ShowNotification("Notification", tostring(message or ""), tonumber(duration) or 5, "info")
			end

			function section.NewSmall(a1, a2, a3)
				local label, callback = UnpackCompatArgs(section, a1, a2, a3)
				return tab.AddButton(label or "Button", callback)
			end

			function section.NewButton(a1, a2, a3, a4)
				local label, helpMessage, callback = UnpackCompatArgs(section, a1, a2, a3, a4)
				if typeof(callback) ~= "function" and typeof(helpMessage) == "function" then
					callback = helpMessage
				end
				return tab.AddButton(label or "Button", callback)
			end

			function section.NewToggle(a1, a2, a3, a4)
				local label, helpMessage, callback = UnpackCompatArgs(section, a1, a2, a3, a4)
				if typeof(callback) ~= "function" and typeof(helpMessage) == "function" then
					callback = helpMessage
				end
				return tab.AddToggle(label or "Toggle", false, callback)
			end

			function section.NewLabel(a1, a2)
				local labelText = (a1 == section) and a2 or a1
				local labelInstance = tab.AddTextLabel(labelText or "")
				local labelAPI = { Instance = labelInstance }
				function labelAPI.UpdateLabel(x, y)
					local newText = (x == labelAPI) and y or x
					if labelInstance and labelInstance.Parent then
						labelInstance.Text = tostring(newText or "")
					end
				end
				return labelAPI
			end

			function section.NewTextBox(a1, a2, a3, a4, a5)
				local label, placeholder, boxName, callback = UnpackCompatArgs(section, a1, a2, a3, a4, a5)
				if typeof(placeholder) == "function" then
					callback, placeholder = placeholder, label
					label = ""
				end
				if label and tostring(label) ~= "" then tab.AddTextLabel(tostring(label)) end
				local box = tab.AddTextBox(placeholder or "", callback)
				return box
			end

			function section.NewSlider(a1, a2, a3, a4, a5)
				local label, minValue, maxValue, callback = UnpackCompatArgs(section, a1, a2, a3, a4, a5)
				minValue = tonumber(minValue) or 0
				maxValue = tonumber(maxValue) or 100
				return tab.AddSlider(label or "Slider", minValue, maxValue, minValue, callback)
			end

			function section.NewDropdown(a1, a2, a3, a4, a5)
				local label, helpMessage, items, callback = UnpackCompatArgs(section, a1, a2, a3, a4, a5)
				-- Also accept the compact form: NewDropdown(label, items, callback).
				if typeof(helpMessage) == "table" then
					if typeof(items) == "function" and callback == nil then callback = items end
					items = helpMessage
				end
				local dropdown = tab.AddDropdown(label or "Dropdown", typeof(items) == "table" and items or {}, callback)
				-- UI2 exposed Refresh(); our native component calls this SetOptions().
				function dropdown.Refresh(x, y)
					local newItems = (x == dropdown) and y or x
					return dropdown.SetOptions(newItems or {})
				end
				return dropdown
			end

			return section
		end

		return tab
	end

	function WindowAPI.ChangeTheme(a, b)
		local themeName = (a == WindowAPI) and b or a
		if typeof(themeName) ~= "string" then return false end
		local aliases = { default = "Default", graphite = "Graphite", green = "Green", emerald = "Emerald", ocean = "Ocean", purple = "Purple", red = "Red", crimson = "Crimson", rose = "Rose", amber = "Amber", monochrome = "Monochrome", minimal = "Minimal", c00l = "c00l", cool = "c00l", troll = "Troll", brainrot = "Brainrot", barbie = "Barbie", halloween = "Purple", christmas = "Ocean" }
		local normalized = aliases[string.lower(themeName)] or themeName
		local result = SetTheme(normalized)
		if result then compatThemeName = normalized end
		return result
	end

	function WindowAPI.GetCurrentTheme()
		return string.lower(compatThemeName)
	end

	-- Existing UI2 scripts sometimes ask the returned window to create tabs
	-- by dot-call and sometimes by colon-call; NewTab above supports both.
	return WindowAPI
end

function UI.CreateMain(a, b, c, d)
	local hubName, subtitle, version
	if a == UI then
		hubName, subtitle, version = b, c, d
	else
		hubName, subtitle, version = a, b, c
	end
	local window = UI.CreateWindow(hubName or "IceHub", subtitle or "", version or "")
	-- Preserve the old property name for scripts that read it directly.
	window.GameName = subtitle or ""
	return window
end

return UI
