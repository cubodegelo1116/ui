-- Repair frequent UTF-8 mojibake patterns caused by saving source text with
-- the wrong encoding. This is deliberately a conservative list of known pairs;
-- it does not try to reinterpret arbitrary user-entered text or binary data.
local TEXT_ENCODING_FIXES = {
    -- Exact malformed sequence reported by the user: "Pra￯﾿ﾃ￯ﾾ§a" -> "praça".
    {"￯﾿ﾃ￯ﾾ§", "ç"},
    -- Exact malformed sequence reported by the user: "apￃﾳs" -> "após".
    {"ￃﾳ", "ó"},
    -- Common visible replacement / mojibake markers. U+FFFD itself cannot
    -- reveal the original missing character, but these known byte-artifacts can.
    {"ï¿½", "�"}, {"â€�", "�"},
    -- Common double-encoded UTF-8 (fix before the single-encoded forms).
    {"ÃƒÂ¡", "á"}, {"ÃƒÂ ", "à"}, {"ÃƒÂ¢", "â"}, {"ÃƒÂ£", "ã"},
    {"ÃƒÂ©", "é"}, {"ÃƒÂª", "ê"}, {"ÃƒÂ­", "í"}, {"ÃƒÂ³", "ó"},
    {"ÃƒÂ´", "ô"}, {"ÃƒÂµ", "õ"}, {"ÃƒÂº", "ú"}, {"ÃƒÂ§", "ç"},
    -- Common single-encoded UTF-8 mojibake.
    {"Ã¡", "á"}, {"Ã ", "à"}, {"Ã¢", "â"}, {"Ã£", "ã"},
    {"Ã©", "é"}, {"Ãª", "ê"}, {"Ã­", "í"}, {"Ã³", "ó"},
    {"Ã´", "ô"}, {"Ãµ", "õ"}, {"Ãº", "ú"}, {"Ã§", "ç"},
    {"Ã€", "À"}, {"Ã‚", "Â"}, {"Ãƒ", "Ã"}, {"Ã‰", "É"},
    {"ÃŠ", "Ê"}, {"Ã“", "Ó"}, {"Ã”", "Ô"}, {"Ã•", "Õ"},
    {"Ãš", "Ú"}, {"Ã‡", "Ç"}, {"Ã‘", "Ñ"},
    {"Âº", "º"}, {"Âª", "ª"}, {"Â°", "°"}, {"Â·", "·"},
    {"â€™", "’"}, {"â€œ", "“"}, {"â€“", "–"}, {"â€”", "—"}, {"â€¦", "…"},
}

local function ReplacePlain(text, search, replacement)
    local startAt = 1
    while true do
        local first, last = string.find(text, search, startAt, true)
        if not first then break end
        text = string.sub(text, 1, first - 1) .. replacement .. string.sub(text, last + 1)
        startAt = first + #replacement
    end
    return text
end

local function FixMojibake(value)
    if typeof(value) ~= "string" then return value end
    local repaired = value

    -- Some editors turn UTF-8 bytes such as C3 B3 into half-width Hangul
    -- codepoints (for example "ￃﾳ" instead of "ó"). Decode those byte pairs
    -- programmatically so this works for every common Portuguese accent, not
    -- only the one exact example that was reported.
    local ok, codepoints = pcall(function()
        local result = {}
        for _, codepoint in utf8.codes(repaired) do
            table.insert(result, codepoint)
        end
        return result
    end)
    if ok and codepoints then
        local decoded = {}
        local index = 1
        while index <= #codepoints do
            local current = codepoints[index]
            local nextCodepoint = codepoints[index + 1]
            local leadByte
            if current == 0xFFC3 then
                leadByte = 0xC3
            elseif current == 0xFFC2 then
                leadByte = 0xC2
            end

            if leadByte and nextCodepoint and nextCodepoint >= 0xFF80 and nextCodepoint <= 0xFFBF then
                local secondByte = nextCodepoint - 0xFF00
                local decodedCodepoint
                if leadByte == 0xC3 then
                    decodedCodepoint = 0xC0 + (secondByte - 0x80)
                else
                    decodedCodepoint = secondByte
                end
                if decodedCodepoint >= 0x80 and decodedCodepoint <= 0xFF then
                    table.insert(decoded, utf8.char(decodedCodepoint))
                    index += 2
                else
                    table.insert(decoded, utf8.char(current))
                    index += 1
                end
            else
                table.insert(decoded, utf8.char(current))
                index += 1
            end
        end
        repaired = table.concat(decoded)
    end

    -- Also repair common Latin-1 mojibake forms ("Ã¡", "aÃ§Ã£o", etc.).
    for _, pair in ipairs(TEXT_ENCODING_FIXES) do
        repaired = ReplacePlain(repaired, pair[1], pair[2])
    end
    return repaired
end

-- Public helper for scripts that need to repair a string before using it.
UI.FixTextEncoding = FixMojibake

local function ValidateString(value, allowNil)
    if allowNil and value == nil then return nil end
    if typeof(value) == "string" then return FixMojibake(value) end
    if typeof(value) == "number" then return tostring(value) end
    if allowNil then return "" end
    error("Expected string or number, got " .. typeof(value), 2)
end

local function Clamp(value, min, max)
	return math.min(math.max(value, min), max)
end

local function CopyTable(tbl)
	local copy = {}
	for k, v in pairs(tbl) do
		copy[k] = v
	end
	return copy
end

local function SafeWait(duration)
	if duration > 0 then
		task.wait(duration)
	end
end

