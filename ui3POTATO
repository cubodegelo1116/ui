	function AddCooldownButton(page, text, cooldown, callback)
		if not page then error("Page required for AddCooldownButton", 2) end
		text = ValidateString(text, true) or "Button"
		cooldown = math.max(0, math.floor(tonumber(cooldown) or 5))

		local Btn = Instance.new("TextButton")
		Btn.Name = text
		Btn.Size = UDim2.new(1, -24, 0, 30)
		Btn.BackgroundColor3 = Theme.Button
