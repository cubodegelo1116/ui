	local function AddMinimizeButton(config, colonConfig)
		-- Accept both dot syntax: Window.AddMinimizeButton({...})
		-- and colon syntax: Window:AddMinimizeButton({...}).
		-- With colon syntax, Lua passes the WindowAPI table as the first argument.
		if colonConfig ~= nil then
			config = colonConfig
		elseif type(config) == "table" and config.AddMinimizeButton ~= nil and config.CreateTab ~= nil then
			-- If called with a colon but no options, use defaults.
			config = {}
		end
		config = type(config) == "table" and config or {}

		local size = config.Size or 50
		local imageSize = config.ImageSize or size * 0.55
		local corner = config.Corner or 1
		local transparency = config.Transparency or 0.25
		local position = config.Position or UDim2.new(0, 20, 0.5, -size / 2)
		local text = config.Text
		local hasText = text ~= nil and tostring(text) ~= ""
		local imageId = config.Image
		-- Text has precedence over Image: explicitly selecting text must never
		-- leave the default icon visible, even when Image is also supplied.
		if hasText then
			imageId = nil
		else
			imageId = imageId or "rbxassetid://7733960981"
		end

		local Ball = Instance.new("ImageButton")
		Ball.Name = "MinimizeButton"
		Ball.Size = UDim2.new(0, size, 0, size)
		Ball.Position = position
		Ball.BackgroundColor3 = Theme.TitleBar
		Ball.BackgroundTransparency = transparency
		Ball.Image = ""
		Ball.BorderSizePixel = 0
		Ball.AutoButtonColor = config.AutoButtonColor ~= false
		Ball.Parent = ScreenGui
		Ball:SetAttribute("ThemeRole", "TitleBar")

		local BallCorner = Instance.new("UICorner")
		BallCorner.CornerRadius = UDim.new(corner, 0)
		BallCorner.Parent = Ball

		local BallStroke = Instance.new("UIStroke")
		BallStroke.Color = Theme.Border
		BallStroke.Thickness = 1.2
		BallStroke.Parent = Ball
		BallStroke:SetAttribute("ThemeRole", "Border")

		if hasText then
			local TextIcon = Instance.new("TextLabel")
			TextIcon.Name = "MinimizeText"
			TextIcon.Size = UDim2.fromScale(1, 1)
			TextIcon.Position = UDim2.fromScale(0, 0)
			TextIcon.BackgroundTransparency = 1
			TextIcon.Text = tostring(text)
			TextIcon.TextColor3 = config.TextColor or Theme.Text
			TextIcon.TextSize = config.TextSize or 22
			TextIcon.Font = config.Font or Enum.Font.GothamBold
			TextIcon.TextScaled = config.TextScaled == true
			TextIcon.TextWrapped = false
			TextIcon.TextXAlignment = Enum.TextXAlignment.Center
			TextIcon.TextYAlignment = Enum.TextYAlignment.Center
			TextIcon.AutoLocalize = false
			TextIcon.Parent = Ball
			TextIcon:SetAttribute("ThemeRole", "Text")
		else
			local Icon = Instance.new("ImageLabel")
			Icon.Name = "MinimizeIcon"
			Icon.Size = UDim2.new(0, imageSize, 0, imageSize)
			Icon.Position = UDim2.new(0.5, -imageSize / 2, 0.5, -imageSize / 2)
			Icon.BackgroundTransparency = 1
			Icon.Image = imageId
			Icon.ImageColor3 = Theme.Text
			Icon.Parent = Ball
			Icon:SetAttribute("ThemeRole", "Text")
		end

		local ballDragging = false
		local ballStart
		local ballPos

		Ball.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 then
				ballDragging = true
				ballStart = input.Position
				ballPos = Ball.Position
			end
		end)

		Ball.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 then
				ballDragging = false
			end
		end)

		ConnectGlobal(UIS.InputChanged, function(input)
			if ballDragging and input.UserInputType == Enum.UserInputType.MouseMovement then
				local delta = input.Position - ballStart
				Ball.Position = UDim2.new(
					ballPos.X.Scale,
					ballPos.X.Offset + delta.X,
					ballPos.Y.Scale,
					ballPos.Y.Offset + delta.Y
				)
			end
		end)

		local guiVisible = true

		Ball.MouseButton1Click:Connect(function()
			guiVisible = not guiVisible
			Main.Visible = guiVisible
		end)

		return Ball
	end

