	local TweenService = {
		Create = function(_, instance, _info, goals)
			return { Play = function() for property, value in pairs(goals) do pcall(function() instance[property] = value end) end end }
		end,
	}
	local TextService = game:GetService("TextService")
	local Players = game:GetService("Players")
	local LocalPlayer = Players.LocalPlayer
	local trackedConnections = {}
	local activeColorPickerClose = nil

	local function ConnectGlobal(signal, callback)
		local connection = signal:Connect(callback)
		table.insert(trackedConnections, connection)
		return connection
	end

	if not LocalPlayer then
		error("LocalPlayer not found", 2)
	end

	-- ════════════════════════════════════════════════════════════
	-- POTATO EDITION | minimal black/white surfaces, theme-colored native borders
	-- ════════════════════════════════════════════════════════════

	local Theme = {
		Background = Color3.fromRGB(20, 21, 24),
		TitleBar = Color3.fromRGB(25, 27, 31),
		TabBackground = Color3.fromRGB(17, 18, 21),
		TabSelected = Color3.fromRGB(29, 43, 59),
		Button = Color3.fromRGB(31, 33, 38),
		ButtonHover = Color3.fromRGB(40, 44, 51),
		Text = Color3.fromRGB(232, 232, 236),
		TextDark = Color3.fromRGB(151, 159, 171),
		Accent = Color3.fromRGB(22, 139, 255),
		ToggleOn = Color3.fromRGB(22, 139, 255),
		ToggleOff = Color3.fromRGB(66, 67, 75),
		Border = Color3.fromRGB(47, 52, 60),
		Cooldown = Color3.fromRGB(115, 53, 58),
		Error = Color3.fromRGB(220, 75, 75),
		Success = Color3.fromRGB(75, 190, 120),
		Warning = Color3.fromRGB(230, 180, 75),
		TabBorder = Color3.fromRGB(47, 52, 60),
		DropdownHover = Color3.fromRGB(51, 52, 59),
	}

	local Themes = {}
	Themes.Default = CopyTable(Theme)
	local AcrylicEnabled = false
	local CurrentThemeName = "Default"
	local SaveConfig -- assigned after the window exists
	local AutoSaveConfig = true
	-- Acrylic is simulated with controlled panel transparency (no global blur).
	-- Higher values make the glass effect more visible; keep text legible.
	local AcrylicTransparency = { Background = 0.34, TitleBar = 0.28, TabBackground = 0.30, TabSelected = 0.22, Button = 0.25, ToggleOn = 0.12, ToggleOff = 0.20 }

	-- ════════════════════════════════════════════════════════════
	-- THEME MANAGEMENT SYSTEM
	-- ════════════════════════════════════════════════════════════

	local function RegisterTheme(name, colors)
		if typeof(name) ~= "string" then
			warn("UI: RegisterTheme - name must be a string")
			return nil
		end

		if typeof(colors) ~= "table" then
			warn("UI: RegisterTheme - colors must be a table")
			return nil
		end

		local newTheme = CopyTable(Themes.Default)

		for key, value in pairs(colors) do
			if newTheme[key] ~= nil then
				if typeof(value) ~= "Color3" then
					warn("UI: RegisterTheme - color '" .. tostring(key) .. "' must be Color3")
					return nil
				end
				newTheme[key] = value
			else
				warn("UI: RegisterTheme - unknown color key: " .. tostring(key))
			end
		end

		Themes[name] = newTheme
		return newTheme
	end

	local ApplyTheme

	local function NormalizePotatoTheme()
		local border = Theme.Accent or Theme.Border or Color3.fromRGB(0, 255, 0)
		Theme.Background = Color3.fromRGB(0, 0, 0)
		Theme.TitleBar = Color3.fromRGB(0, 0, 0)
		Theme.TabBackground = Color3.fromRGB(0, 0, 0)
		Theme.TabSelected = Color3.fromRGB(0, 0, 0)
		Theme.Button = Color3.fromRGB(0, 0, 0)
		Theme.ButtonHover = Color3.fromRGB(0, 0, 0)
		Theme.Text = Color3.fromRGB(255, 255, 255)
		Theme.TextDark = Color3.fromRGB(255, 255, 255)
		Theme.ToggleOn = Color3.fromRGB(0, 0, 0)
		Theme.ToggleOff = Color3.fromRGB(0, 0, 0)
		Theme.Border = border
		Theme.TabBorder = border
		Theme.DropdownHover = Color3.fromRGB(0, 0, 0)
		AcrylicEnabled = false
	end

	local function SetTheme(themeName)
		if typeof(themeName) == "string" then
			if not Themes[themeName] then
				warn("UI: SetTheme - theme '" .. themeName .. "' does not exist")
				return false
			end

			local selectedTheme = Themes[themeName]
			CurrentThemeName = themeName
			for key, value in pairs(selectedTheme) do
				if Theme[key] ~= nil then
					Theme[key] = value
				end
			end
		elseif typeof(themeName) == "table" then
			CurrentThemeName = nil
			for key, value in pairs(themeName) do
				if Theme[key] ~= nil and typeof(value) ~= "Color3" then
					warn("UI: SetTheme - color '" .. tostring(key) .. "' must be Color3")
					return false
				end
			end
			for key, value in pairs(themeName) do
				if Theme[key] ~= nil then
					Theme[key] = value
				end
			end
		else
			warn("UI: SetTheme - invalid theme type")
			return false
		end

		NormalizePotatoTheme()
		ApplyTheme()
		if AutoSaveConfig and SaveConfig then SaveConfig() end
		return true
	end

	local function SetAcrilic(enabled)
		-- Acrylic only affects the library's own panels; never blur Lighting/the whole game.
		AcrylicEnabled = false
		if ApplyTheme then ApplyTheme() end
		if AutoSaveConfig and SaveConfig then SaveConfig() end
		return false
	end

	local function GetAcrilic()
		return false
	end

	local function GetTheme(themeName)
		if themeName then
			local selected = Themes[themeName]
			return selected and CopyTable(selected) or nil
		end
		return CopyTable(Theme)
	end

	local function GetAllThemes()
		local result = {}
		for name in pairs(Themes) do
			table.insert(result, name)
		end
		table.sort(result)
		return result
	end

