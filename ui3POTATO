	local TitleLabel = CreateHeaderLabel("Title", title, Theme.Text, 15, Enum.Font.GothamBold)
	local SubtitleLabel = CreateHeaderLabel("Subtitle", subtitle, Theme.TextDark, 12, Enum.Font.Gotham)
	local VersionLabel = CreateHeaderLabel("Version", version, Theme.TextDark, 11, Enum.Font.Gotham)

	local function LayoutHeaderText()
		if not TitleBar.Parent then return end
		local rightReserve = 76 -- leave room for minimize and close controls
		local available = math.max(0, TitleBar.AbsoluteSize.X - 14 - rightReserve)
		local gap = 8
		local function Measure(text, size, font)
			if not text or text == "" then return 0 end
			return math.ceil(TextService:GetTextSize(text, size, font, Vector2.new(2000, 40)).X) + 2
		end
		local titleWanted = Measure(title, 15, Enum.Font.GothamMedium)
		local subtitleWanted = Measure(subtitle, 12, Enum.Font.Gotham)
		local versionWanted = Measure(version, 11, Enum.Font.Gotham)
		local titleWidth = math.min(titleWanted, available * 0.42)
		local subtitleWidth = math.min(subtitleWanted, available * 0.30)
		local nonEmpty = (title ~= "" and 1 or 0) + (subtitle ~= "" and 1 or 0) + (version ~= "" and 1 or 0)
		local gaps = math.max(0, nonEmpty - 1) * gap
		local versionWidth = math.min(versionWanted, math.max(0, available - titleWidth - subtitleWidth - gaps))
		-- If the title/subtitle are empty, give the remaining room to the next visible label.
		if title == "" then titleWidth = 0 end
		if subtitle == "" then subtitleWidth = 0 end
		if version == "" then versionWidth = 0 end
		local x = 14
		TitleLabel.Visible = title ~= ""
		TitleLabel.Position = UDim2.new(0, x, 0, 0)
		TitleLabel.Size = UDim2.new(0, titleWidth, 1, 0)
		if title ~= "" then x += titleWidth + ((subtitle ~= "" or version ~= "") and gap or 0) end
		SubtitleLabel.Visible = subtitle ~= ""
		SubtitleLabel.Position = UDim2.new(0, x, 0, 0)
		SubtitleLabel.Size = UDim2.new(0, subtitleWidth, 1, 0)
		if subtitle ~= "" then x += subtitleWidth + (version ~= "" and gap or 0) end
		VersionLabel.Visible = version ~= ""
		VersionLabel.Position = UDim2.new(0, x, 0, 0)
		VersionLabel.Size = UDim2.new(0, versionWidth, 1, 0)
	end
	LayoutHeaderText()
	TitleBar:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		task.defer(LayoutHeaderText)
	end)

