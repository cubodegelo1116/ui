	local function ResolveTabIcon(icon)
		if typeof(icon) == "number" then
			if icon > 0 then return "image", "rbxassetid://" .. tostring(math.floor(icon)) end
			return nil, nil
		end
		if typeof(icon) == "table" then
			if icon.Image or icon.image then
				local image = icon.Image or icon.image
				if typeof(image) == "number" then image = "rbxassetid://" .. tostring(math.floor(image)) end
				return "image", tostring(image)
			end
			icon = icon.Icon or icon.icon or icon.Name or icon.name
		end
		if typeof(icon) ~= "string" or icon == "" then return nil, nil end
		local lower = string.lower(icon)
		if BuiltInTabImages[lower] then return "image", BuiltInTabImages[lower] end
		if BuiltInTabAssetIcons[lower] then return "image", "rbxassetid://" .. tostring(BuiltInTabAssetIcons[lower]) end
		if tonumber(icon) then return "image", "rbxassetid://" .. tostring(math.floor(tonumber(icon))) end
		if lower:match("^rbxassetid://") or lower:match("^rbxasset://") or lower:match("^rbxthumb://") or lower:match("^https?://") then
			return "image", icon
		end
		if BuiltInTabIcons[lower] then return "glyph", BuiltInTabIcons[lower] end
		return nil, nil
	end

