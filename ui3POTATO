	-- POTATO 4.8.5: square geometry and native borders only where the original
	-- library explicitly created a UIStroke. Never blanket-border every GuiObject.
	local function ApplyPotatoPrimitive(instance)
		if instance:IsA("UICorner") then
			instance:Destroy()
		elseif instance:IsA("UIStroke") then
			local parent = instance.Parent
			if parent and parent:IsA("GuiObject") then
				parent.BorderSizePixel = 1
				parent.BorderColor3 = Theme.Border
			end
			instance:Destroy()
		elseif instance:IsA("TextLabel") or instance:IsA("TextButton") or instance:IsA("TextBox") then
			instance.TextColor3 = Color3.fromRGB(255, 255, 255)
			instance.TextStrokeTransparency = 1
			if instance:IsA("TextBox") then instance.PlaceholderColor3 = Color3.fromRGB(255, 255, 255) end
		end
	end
	ScreenGui.DescendantAdded:Connect(function(instance)
		task.defer(function() if instance.Parent then ApplyPotatoPrimitive(instance) end end)
	end)

	for _, instance in ipairs(ScreenGui:GetDescendants()) do ApplyPotatoPrimitive(instance) end

	-- Normalize text styling immediately; don't remove ordinary UIStroke borders from buttons/tabs.
	local function RemoveTextHighlight(object)
		if not (object:IsA("TextLabel") or object:IsA("TextButton") or object:IsA("TextBox")) then
			return
		end

		-- Apply the same opt-out to text controls in case a GUI object overrides it.
		pcall(function() object.AutoLocalize = false end)
		if object:IsA("TextBox") then
			object.PlaceholderText = FixMojibake(object.PlaceholderText)
			if object.Text ~= "" then object.Text = FixMojibake(object.Text) end
		else
			object.Text = FixMojibake(object.Text)
		end

		object.TextStrokeTransparency = 1
		object.TextStrokeColor3 = Color3.new(0, 0, 0)
		object.RichText = false
		object:SetAttribute("PDDEV_NoTextStroke", true)

		local function RemoveTextEffect(child)
			-- A UIGradient directly on a text object can create colored/bright glyphs.
			if child:IsA("UIGradient") or child:GetAttribute("PDDEV_TextGlow") == true then
				child:Destroy()
				return
			end
			-- Preserve explicitly tagged component borders; remove untagged strokes
			-- attached directly to text controls, which are often used as fake text glow.
			if child:IsA("UIStroke") then
				task.defer(function()
					if child.Parent == object then
						local role = child:GetAttribute("ThemeRole")
						if role == "Border" or role == "TabBorder" or child:GetAttribute("PDDEV_KeepTextControlStroke") == true then
							-- Keep the component border but never let the UIStroke contour glyphs.
							pcall(function() child.ApplyStrokeMode = Enum.ApplyStrokeMode.Border end)
						else
							child:Destroy()
						end
					end
				end)
			end
		end

		for _, child in ipairs(object:GetChildren()) do
			RemoveTextEffect(child)
		end

		if not object:GetAttribute("PDDEV_TextStrokeGuard") then
			object:SetAttribute("PDDEV_TextStrokeGuard", true)
			object:GetPropertyChangedSignal("TextStrokeTransparency"):Connect(function()
				if object.Parent and object.TextStrokeTransparency ~= 1 then
					object.TextStrokeTransparency = 1
				end
			end)
			-- Static labels/buttons can also be updated later (status labels, dropdown
			-- selection text, cooldown text, etc.), so repair those updates as well.
			if not object:IsA("TextBox") then
				object:GetPropertyChangedSignal("Text"):Connect(function()
					if not object.Parent then return end
					local repaired = FixMojibake(object.Text)
					if repaired ~= object.Text then object.Text = repaired end
				end)
			else
				object:GetPropertyChangedSignal("PlaceholderText"):Connect(function()
					if not object.Parent then return end
					local repaired = FixMojibake(object.PlaceholderText)
					if repaired ~= object.PlaceholderText then object.PlaceholderText = repaired end
				end)
			end
			object.ChildAdded:Connect(RemoveTextEffect)
		end
	end


	-- Track only objects that can be affected by theme changes. This avoids
	-- repeatedly walking every descendant (including layout objects and popups)
	-- whenever a large hub changes theme or toggles Acrylic.
	local TrackedThemeObjects = setmetatable({}, { __mode = "k" })
	local function TrackThemeObject(object)
		if not object then return end
		local isText = object:IsA("TextLabel") or object:IsA("TextButton") or object:IsA("TextBox")
		local isStroke = object:IsA("UIStroke")
		-- Ignore non-visual instances such as UIListLayout/UIPadding.
		local isScrollingFrame = object:IsA("ScrollingFrame")
		if not (isText or isStroke or object:IsA("GuiObject")) then return end
		if TrackedThemeObjects[object] then return end
		local role = object:GetAttribute("ThemeRole")
		-- ScrollingFrames need theme tracking even when they have no ThemeRole.
		if isText or isStroke or isScrollingFrame or role ~= nil then
			TrackedThemeObjects[object] = true
		end
		if isText then
			task.defer(function()
				if object.Parent then RemoveTextHighlight(object) end
			end)
		end
		if not object:GetAttribute("PDDEV_ThemeRoleTracker") then
			object:SetAttribute("PDDEV_ThemeRoleTracker", true)
			object:GetAttributeChangedSignal("ThemeRole"):Connect(function()
				if object.Parent and object:GetAttribute("ThemeRole") ~= nil then
					TrackedThemeObjects[object] = true
				end
			end)
		end
	end

	-- DescendantAdded also catches controls created later by the hub script.
	ScreenGui.DescendantAdded:Connect(TrackThemeObject)
	for _, object in ipairs(ScreenGui:GetDescendants()) do
		TrackThemeObject(object)
	end

	-- Constructors still create controls synchronously to preserve the existing
	-- API and return values. Expensive theme refreshes now touch only tracked
	-- text/stroke/theme-role instances instead of the entire UI tree.

	-- Wrap by measured pixel width, including very long words without spaces.
	local function WrapTextToWidth(value, font, textSize, maxWidth)
		value = FixMojibake(tostring(value or ""))
		maxWidth = math.max(24, tonumber(maxWidth) or 80)
		local lines = {}

		local function Measure(line)
			return TextService:GetTextSize(line, textSize, font, Vector2.new(10000, 1000)).X
		end

		local function SplitLongWord(word)
			local chars = {}
			local i = 1
			while i <= #word do
				local first = string.byte(word, i)
				local length = 1
				if first >= 240 then length = 4
				elseif first >= 224 then length = 3
				elseif first >= 192 then length = 2 end
				table.insert(chars, string.sub(word, i, math.min(#word, i + length - 1)))
				i += length
			end

			local chunks, chunk = {}, ""
			for _, char in ipairs(chars) do
				if chunk ~= "" and Measure(chunk .. char) > maxWidth then
					table.insert(chunks, chunk)
					chunk = char
				else
					chunk ..= char
				end
			end
			if chunk ~= "" then table.insert(chunks, chunk) end
			return chunks
		end

		for paragraph in (value .. "\n"):gmatch("(.-)\n") do
			if paragraph == "" then
				table.insert(lines, "")
			else
				local line = ""
				for word in paragraph:gmatch("%S+") do
					local candidate = (line == "") and word or (line .. " " .. word)
					if Measure(candidate) <= maxWidth then
						line = candidate
					else
						if line ~= "" then table.insert(lines, line); line = "" end
						if Measure(word) <= maxWidth then
							line = word
						else
							local chunks = SplitLongWord(word)
							for index = 1, #chunks - 1 do table.insert(lines, chunks[index]) end
							line = chunks[#chunks] or ""
						end
					end
				end
				if line ~= "" then table.insert(lines, line) end
			end
		end

		return table.concat(lines, "\n")
	end

	-- Manually wrap labels by their current pixel width. This is reliable for
	-- labels inside ScrollingFrames and also responds when the main window resizes.
	local function SetupResponsiveText(label, initialText, minimumHeight)
		local rawText = FixMojibake(tostring(initialText or ""))
		local formatting = false
		local lastFormattedText = nil
		local lastWidth = -1

		local function Refresh(force)
			if not label.Parent then return end
			local width = label.AbsoluteSize.X
			if width <= 1 then return end
			if not force and math.abs(width - lastWidth) < 1 then return end
			lastWidth = width

			local wrapped = WrapTextToWidth(rawText, label.Font, label.TextSize, width)
			local bounds = TextService:GetTextSize(
				wrapped,
				label.TextSize,
				label.Font,
				Vector2.new(width, 10000)
			)
			local height = math.max(tonumber(minimumHeight) or (label.TextSize + 4), math.ceil(bounds.Y) + 3)
			local oldSize = label.Size
			formatting = true
			label.TextWrapped = false -- text is explicitly wrapped above, preventing overflow
			label.TextTruncate = Enum.TextTruncate.None
			lastFormattedText = wrapped
			label.Text = wrapped
			label.Size = UDim2.new(oldSize.X.Scale, oldSize.X.Offset, 0, height)
			formatting = false
		end

		label:GetPropertyChangedSignal("Text"):Connect(function()
			if formatting or label.Text == lastFormattedText then return end
			rawText = FixMojibake(label.Text)
			lastWidth = -1
			task.defer(function() Refresh(true) end)
		end)
		label:GetPropertyChangedSignal("TextSize"):Connect(function()
			lastWidth = -1
			task.defer(function() Refresh(true) end)
		end)
		label:GetPropertyChangedSignal("Font"):Connect(function()
			lastWidth = -1
			task.defer(function() Refresh(true) end)
		end)
		label:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
			task.defer(function() Refresh(false) end)
		end)
		task.defer(function() Refresh(true) end)
		return function(newText)
			rawText = FixMojibake(tostring(newText or ""))
			lastWidth = -1
			Refresh(true)
		end
	end

	for _, object in ipairs(ScreenGui:GetDescendants()) do
		RemoveTextHighlight(object)
	end
	ScreenGui.DescendantAdded:Connect(function(object)
		RemoveTextHighlight(object)
	end)

	ScreenGui.Destroying:Connect(function()
		for _, connection in ipairs(trackedConnections) do
