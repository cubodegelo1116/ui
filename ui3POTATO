		Btn.AutoButtonColor = false
		Btn.ClipsDescendants = true
		Btn.Parent = page
		Btn:SetAttribute("ThemeRole", "Button")
		Btn.TextStrokeTransparency = 1

		local Padding = Instance.new("UIPadding")
		Padding.PaddingLeft = UDim.new(0, 11)
		Padding.PaddingRight = UDim.new(0, 10)
		Padding.Parent = Btn

		local Corner = Instance.new("UICorner")
		Corner.CornerRadius = UDim.new(0, 5)
		Corner.Parent = Btn

		local Stroke = Instance.new("UIStroke")
		Stroke.Color = Theme.Border
		Stroke.Thickness = 1
		Stroke.Transparency = 0.28
		Stroke.Parent = Btn
		Stroke:SetAttribute("ThemeRole", "Border")

		Btn.MouseEnter:Connect(function()
			TweenService:Create(Btn, TweenInfo.new(0.12), {BackgroundColor3 = Theme.ButtonHover}):Play()
			TweenService:Create(Stroke, TweenInfo.new(0.12), {Color = Theme.Accent or Theme.Border, Transparency = 0}):Play()
		end)
		Btn.MouseLeave:Connect(function()
			if not onCooldown then
				TweenService:Create(Btn, TweenInfo.new(0.12), {BackgroundColor3 = Theme.Button}):Play()
			end
			TweenService:Create(Stroke, TweenInfo.new(0.12), {Color = Theme.Border, Transparency = 0.28}):Play()
		end)

		local onCooldown = false
		local cooldownToken = 0

		Btn.MouseButton1Click:Connect(function()
			if onCooldown then return end

			onCooldown = true
			cooldownToken += 1
			local thisToken = cooldownToken

			if typeof(callback) == "function" then
				local ok, err = pcall(callback)
				if not ok then warn("UI cooldown callback error: " .. tostring(err)) end
			end

			task.spawn(function()
				for i = cooldown, 1, -1 do
					if thisToken ~= cooldownToken then return end
					Btn.Text = tostring(i)
					TweenService:Create(Btn, TweenInfo.new(0.1), {BackgroundColor3 = Theme.Cooldown}):Play()
					SafeWait(1)
				end

				if thisToken ~= cooldownToken then return end
				Btn.Text = text
				TweenService:Create(Btn, TweenInfo.new(0.2), {BackgroundColor3 = Theme.Button}):Play()
				onCooldown = false
			end)
		end)

		-- API
		local CooldownAPI = {}
		function CooldownAPI.IsOnCooldown()
			return onCooldown
		end
		function CooldownAPI.ResetCooldown()
			cooldownToken += 1
			onCooldown = false
			Btn.Text = text
			Btn.BackgroundColor3 = Theme.Button
		end

		return CooldownAPI
	end

