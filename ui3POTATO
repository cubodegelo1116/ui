		local function NormalizeOptions(values)
			local normalized = {}
			if typeof(values) == "table" then
				for _, value in ipairs(values) do
					if value ~= nil then table.insert(normalized, FixMojibake(tostring(value))) end
				end
			end
			return normalized
		end
		currentOptions = NormalizeOptions(items)
		selectedValue = currentOptions[1]

