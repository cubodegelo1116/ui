	local function UnpackCompatArgs(owner, a, b, c, d, e, f)
		if a == owner then
			return b, c, d, e, f
		end
		return a, b, c, d, e
	end

	-- Searchable dropdown matching the old UI2 NewSearchDropdown API.
	-- The search field filters options while typing; Refresh() replaces the list.
	local function CreateCompatSearchDropdown(page, title, searchPlaceholder, items, callback)
		if not page then error("Page required for NewSearchDropdown", 2) end
		title = ValidateString(title, true) or "Dropdown"
