	-- CONFIG PERSISTENCE (executor file APIs, when available)
	-- Saves built-in theme, acrylic state, and window dimensions.
	-- In ordinary Roblox scripts, writefile/readfile are unavailable; the UI
	-- continues working normally and persistence simply reports false.
	-- ════════════════════════════════════════════════════════════
	local HttpService = game:GetService("HttpService")
	local CONFIG_PATH = "PDDEV_UI_Config.json"

	local function ConfigFileApisAvailable()
		return typeof(writefile) == "function" and typeof(readfile) == "function"
	end

	SaveConfig = function()
		if not ConfigFileApisAvailable() then return false, "writefile/readfile unavailable" end
		local payload = {
			version = 1,
			theme = CurrentThemeName or "Default",
			acrylic = AcrylicEnabled,
			width = math.floor(Main.Size.X.Offset),
			height = math.floor(Main.Size.Y.Offset),
		}
		local ok, err = pcall(function()
			writefile(CONFIG_PATH, HttpService:JSONEncode(payload))
		end)
		if not ok then
			warn("PDDEV: couldn't save config: " .. tostring(err))
			return false, err
		end
		return true
	end

	local function LoadConfig()
		if not ConfigFileApisAvailable() then return false, "writefile/readfile unavailable" end
		local ok, result = pcall(function()
			if typeof(isfile) == "function" and not isfile(CONFIG_PATH) then return nil end
			return HttpService:JSONDecode(readfile(CONFIG_PATH))
		end)
		if not ok or typeof(result) ~= "table" then return false end

		if typeof(result.theme) == "string" and Themes[result.theme] then
			CurrentThemeName = result.theme
			for key, value in pairs(Themes[result.theme]) do
				if Theme[key] ~= nil then Theme[key] = value end
			end
		end
		if typeof(result.acrylic) == "boolean" then AcrylicEnabled = result.acrylic end
		if typeof(result.width) == "number" and typeof(result.height) == "number" then
			Main.Size = UDim2.fromOffset(
				Clamp(math.floor(result.width), MIN_WINDOW_WIDTH, MAX_WINDOW_WIDTH),
				Clamp(math.floor(result.height), MIN_WINDOW_HEIGHT, MAX_WINDOW_HEIGHT)
			)
		end
		return true
	end

	-- Load before the first theme pass so the saved state is visible immediately.
	LoadConfig()

	-- Apply the default palette before returning the window. This prevents
	-- bright default strokes/text styles from remaining until the first theme change.
	ApplyTheme()

