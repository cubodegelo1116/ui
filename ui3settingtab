--[[
    PDDEV / RCCDEV
    SettingsTab V4.0.0
    Theme settings compatible with PDDEV UI Library V4 and legacy window APIs.
]]

local SettingsTab = {}

local THEMES = {
    "Graphite",
    "Default",
    "Ocean",
    "Purple",
    "Red",
    "Minimal",
}

function SettingsTab.Create(a, b)
    -- Supports SettingsTab:Create(Window) and SettingsTab.Create(Window).
    local Window = (a == SettingsTab) and b or a

    assert(type(Window) == "table",
        "[PDDEV SettingsTab] Janela ausente. Passe o objeto retornado por UI.CreateMain(...) ou UI.CreateWindow(...).")

    local function ApplyTheme(themeName)
        if type(Window.SetTheme) == "function" then
            -- V4 SetTheme supports both dot and colon calls; dot keeps compatibility with older versions.
            local ok, result = pcall(Window.SetTheme, themeName)
            if ok then return result end
            warn("[PDDEV SettingsTab] Falha ao aplicar tema: " .. tostring(result))
            return false
        elseif type(Window.ChangeTheme) == "function" then
            return Window.ChangeTheme(themeName)
        end
        warn("[PDDEV SettingsTab] A janela não oferece SetTheme nem ChangeTheme.")
        return false
    end

    local Settings

    -- Native API: CreateWindow -> CreateTab -> AddDropdown.
    if type(Window.CreateTab) == "function" then
        Settings = Window.CreateTab("Settings", "settings")
        assert(Settings, "[PDDEV SettingsTab] Não foi possível criar a aba Settings.")
        assert(type(Settings.AddDropdown) == "function",
            "[PDDEV SettingsTab] A aba não possui AddDropdown.")

        Settings.AddDropdown("Theme", THEMES, function(value)
            ApplyTheme(value)
        end)

    -- Legacy API: CreateMain -> NewTab -> NewSection -> NewDropdown.
    elseif type(Window.NewTab) == "function" then
        Settings = Window.NewTab("Settings", "settings")
        assert(Settings, "[PDDEV SettingsTab] Não foi possível criar a aba Settings via NewTab.")

        if type(Settings.AddDropdown) == "function" then
            Settings.AddDropdown("Theme", THEMES, function(value)
                ApplyTheme(value)
            end)
        elseif type(Settings.NewSection) == "function" then
            local Section = Settings.NewSection()
            assert(Section and type(Section.NewDropdown) == "function",
                "[PDDEV SettingsTab] A seção não possui NewDropdown.")
            Section.NewDropdown("Theme", "Choose the UI theme", THEMES, function(value)
                ApplyTheme(value)
            end)
        elseif type(Settings.NewDropdown) == "function" then
            Settings.NewDropdown("Theme", "Choose the UI theme", THEMES, function(value)
                ApplyTheme(value)
            end)
        else
            error("[PDDEV SettingsTab] Não encontrei AddDropdown nem NewSection/NewDropdown na aba.", 2)
        end
    else
        error("[PDDEV SettingsTab] O objeto recebido não possui CreateTab nem NewTab. Passe a janela retornada por UI.CreateMain(...).", 2)
    end

    return Settings
end

return SettingsTab
