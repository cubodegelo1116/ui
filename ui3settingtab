    ║       PDDEV / RCCDEV - SETTINGS       ║
    ║              Version 4.8.8            ║
    ╚══════════════════════════════════════╝

    Compatível com PDDEV UI Library V4.8.8.
    - Lista os temas diretamente da biblioteca (inclui MI Team).
    - Acrylic sincronizado com o estado carregado pela biblioteca.
    - Mantém compatibilidade com chamadas usando ponto ou dois-pontos.
]]

local SettingsTab = {}

local FALLBACK_THEMES = {
    "Aqua", "Amber", "Barbie", "Brainrot", "c00l", "Crimson",
    "Default", "Emerald", "Graphite", "Green", "MI Team", "Minimal",
    "Monochrome", "Ocean", "Purple", "Red", "Rose", "Troll",
}

local function CallWindowMethod(Window, methodName, ...)
    local method = Window and Window[methodName]
    if type(method) ~= "function" then
        return false, "Método " .. methodName .. " não encontrado."
    end

    local args = table.pack(...)
    local ok, result = pcall(function()
        return method(table.unpack(args, 1, args.n))
    end)
    if ok then return true, result end

    -- Compatibilidade com implementações que exigem Window como self.
    local okWithSelf, resultWithSelf = pcall(function()
        return method(Window, table.unpack(args, 1, args.n))
    end)
    if okWithSelf then return true, resultWithSelf end
    return false, resultWithSelf or result
end

function SettingsTab.Create(a, b)
    local Window = (a == SettingsTab) and b or a
    assert(type(Window) == "table", "[PDDEV SettingsTab] Janela ausente.")

    local createTab = Window.CreateTab or Window.NewTab
    assert(type(createTab) == "function",
        "[PDDEV SettingsTab] A janela não possui CreateTab/NewTab.")

    local ok, Settings = CallWindowMethod(Window, Window.CreateTab and "CreateTab" or "NewTab",
        "Settings", "settings")
    assert(ok and Settings, "[PDDEV SettingsTab] Não foi possível criar a aba Settings: " .. tostring(Settings))

    -- Pega os temas registrados na própria biblioteca. O fallback mantém
    -- compatibilidade com versões antigas que ainda não expõem GetAllThemes.
    local themes = FALLBACK_THEMES
    local themesOK, registeredThemes = CallWindowMethod(Window, "GetAllThemes")
    if themesOK and type(registeredThemes) == "table" and #registeredThemes > 0 then
        themes = registeredThemes
    end

    local function ApplyTheme(themeName)
        local applied, result = CallWindowMethod(Window, "SetTheme", themeName)
        if not applied or result == false then
            warn("[PDDEV SettingsTab] Falha ao aplicar tema '" .. tostring(themeName) .. "': " .. tostring(result))
        end
    end

    if type(Settings.AddDropdown) == "function" then
        Settings.AddDropdown("Theme", themes, ApplyTheme)
    elseif type(Settings.NewDropdown) == "function" then
        Settings.NewDropdown("Theme", "Choose the UI theme", themes, ApplyTheme)
    else
        warn("[PDDEV SettingsTab] Esta aba não oferece AddDropdown/NewDropdown.")
    end

    -- O método dedicado já inicia o toggle com AcrylicEnabled restaurado do config.
    if type(Settings.AddAcrylicToggle) == "function" then
        Settings.AddAcrylicToggle("Acrylic (fundo translúcido)")
    elseif type(Settings.AddToggle) == "function" then
        local initial = false
        local getterName = type(Window.GetAcrylic) == "function" and "GetAcrylic" or "GetAcrilic"
        local getterOK, getterValue = CallWindowMethod(Window, getterName)
        if getterOK and type(getterValue) == "boolean" then
            initial = getterValue
        end

        Settings.AddToggle("Acrylic (fundo translúcido)", initial, function(enabled)
            local setterName = type(Window.SetAcrylic) == "function" and "SetAcrylic" or "SetAcrilic"
            local changed, result = CallWindowMethod(Window, setterName, enabled)
            if not changed then
                warn("[PDDEV SettingsTab] Falha ao alternar Acrylic: " .. tostring(result))
            end
        end)
    else
        warn("[PDDEV SettingsTab] Esta aba não oferece um método de toggle compatível.")
    end

    return Settings
end

return SettingsTab
