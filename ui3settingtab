local SettingsTab = {}

function SettingsTab:Create(Window)
    local Settings = Window.CreateTab("Settings", "settings")

    Settings.AddDropdown("Theme", {
        "Default",
        "Ocean",
        "Purple",
        "Red",
        "Minimal"
    }, function(value)
        Window.SetTheme(value)
    end)

    return Settings
end

return SettingsTab
